async function renderNotebook(type = 'bookmarks') {
    const container = document.getElementById('bookmarksListContainer');
    container.innerHTML = `<div style="text-align:center; padding:50px; color:var(--text-muted);"><i class="fas fa-spinner fa-spin fa-2x"></i><br><br>Loading Questions from Cloud...</div>`;
    
    let dataObj = {};
    if(type === 'bookmarks') {
        let str = await getItemDB('dsssb_bookmarks');
        dataObj = str ? JSON.parse(str) : {};
    } else {
        let str = await getItemDB('dsssb_mistakes');
        dataObj = str ? JSON.parse(str) : {};
    }

    dataObj = await resolveSmartRefs(dataObj);

    let availableSections = new Set();
    let availableTopics = new Set();

    Object.values(dataObj).forEach(q => {
        availableSections.add(q.section || "General");
        if(q.topic) availableTopics.add(q.topic);
    });

    let secSelect = document.getElementById('nbSecFilter');
    let topSelect = document.getElementById('nbTopFilter');
    
    let currSec = secSelect.value;
    let currTop = topSelect.value;
    
    let secHtml = '<option value="ALL">All Sections</option>';
    Array.from(availableSections).sort().forEach(s => secHtml += `<option value="${s}">${s}</option>`);
    let topHtml = '<option value="ALL">All Topics</option>';
    Array.from(availableTopics).sort().forEach(t => topHtml += `<option value="${t}">${t}</option>`);
    
    secSelect.innerHTML = secHtml;
    topSelect.innerHTML = topHtml;
    
    if (availableSections.has(currSec)) secSelect.value = currSec;
    if (availableTopics.has(currTop)) topSelect.value = currTop;

    let secFilter = secSelect.value;
    let topFilter = topSelect.value;

    let grouped = {};
    Object.keys(dataObj).forEach(k => {
        let q = dataObj[k];
        q._key = k;
        let sec = q.section || "General";
        let top = q.topic || "";
        
        if (secFilter !== "ALL" && sec !== secFilter) return;
        if (topFilter !== "ALL" && top !== topFilter) return;

        if(!grouped[sec]) grouped[sec] = [];
        grouped[sec].push(q);
    });

    if(Object.keys(grouped).length === 0) {
        container.innerHTML = `<div style="text-align:center; padding:50px 20px; color:var(--text-muted);">
            <div style="font-size:40px; margin-bottom:10px;">${type === 'bookmarks' ? '🔖' : '❌'}</div>
            <h3 style="color:var(--text-main);">No questions found</h3>
            <p style="font-size:13px; margin-top:8px;">Change your filters or attempt a mock to save questions.</p>
        </div>`;
        return;
    }

    let html = "";
    for(let sec in grouped) {
        html += `<h3 style="color:var(--primary); border-bottom:2px solid var(--primary); padding-bottom:5px; margin-top:15px; font-size:16px;">${sec} <span style="font-size:12px; color:var(--text-muted); float:right; background:var(--primary-light); padding:2px 8px; border-radius:10px;">${grouped[sec].length} Qs</span></h3>`;
        
        grouped[sec].reverse().forEach(q => {
            let correctIdx = parseInt(q.ans) - 1;
            let qText = cleanMathText(q.q_hi || q.q_en);
            let optArr = q.op_hi || q.op_en;
            let correctAnsText = optArr && optArr[correctIdx] ? optArr[correctIdx] : "Not Specified";
            
            let topicHtml = q.topic ? `<span style="margin-left:8px; background:var(--primary-light); color:var(--primary-dark); padding:2px 6px; border-radius:4px; font-size:10px;">🏷️ ${q.topic}</span>` : '';
            let solId = `sol_${type}_${q._key}`;

           let optionsHTML = `<div style="margin-top:10px; display:flex; flex-direction:column; gap:8px;" id="nb_opts_${q._key}">`;
            if (optArr) {
                optArr.forEach((opt, optIdx) => {
                    optionsHTML += `<div class="nb-inline-opt" onclick="checkNotebookInlineAns(this, '${q._key}', ${optIdx}, ${correctIdx}, '${solId}')" style="padding:12px 15px; border:1px solid var(--border); border-radius:10px; font-size:14px; background:var(--bg-body); color:var(--text-main); cursor:pointer; transition:0.2s;"><b>${String.fromCharCode(65+optIdx)})</b> ${cleanMathText(opt)}</div>`;
                });
            }
            optionsHTML += '</div>';

            let solText = cleanMathText(q.solution);
            let aiBtnHtml = "";
            if (!q.solution || q.solution.trim() === "") {
                 aiBtnHtml = `<div id="ai_sol_nb_${type}_${q._key}" style="margin-top: 10px; padding: 10px; background: rgba(99, 102, 241, 0.05); border-radius: 8px; border: 1px dashed var(--primary-light);">
                    <p style="color:var(--text-muted); font-size:13px; margin-bottom:10px;">💡 No solution available in database.</p>
                    <button onclick="generateNbAISolution('${q._key}', '${type}')" style="background:var(--gradient-main); color:white; border:none; padding:8px 15px; border-radius:6px; cursor:pointer; font-weight:bold; font-size:13px; box-shadow: 0 4px 10px rgba(99,102,241,0.2);">🤖 Generate Smart Solution (AI)</button>
                 </div>`;
                 solText = "";
            }

            html += `
            <div class="test-card" style="margin-bottom:15px; border-left:4px solid ${type==='bookmarks'?'var(--warning)':'var(--danger)'};">
                <div style="display:flex; justify-content:space-between; margin-bottom:12px; align-items:flex-start;">
                    <div>
                        <span style="font-size:11px; background:${type==='bookmarks'?'var(--warning)':'var(--danger)'}; color:#fff; padding:3px 8px; border-radius:6px; font-weight:800;">${type==='bookmarks'?'Saved':'Mistake'}</span>
                        ${topicHtml}
                    </div>
                    <button onclick="removeNotebookItem('${q._key}', '${type}')" style="background:none; border:none; color:var(--text-muted); cursor:pointer; font-weight:700;"><i class="fas fa-trash"></i></button>
                </div>
                
                <div style="font-weight:700; font-size:15px; margin-bottom:10px; line-height:1.5;">${qText}</div>
                
                ${optionsHTML}

                <button onclick="toggleNbSolution('${solId}', this)" style="margin-top:15px; width:100%; padding:12px; background:var(--primary-light); color:var(--primary-dark); border:1px solid var(--primary); border-radius:8px; font-weight:bold; cursor:pointer; font-size:13px; transition:0.3s;">
                    👁️ Show Answer & Solution
                </button>

                <div id="${solId}" style="display:none; background:var(--bg-body); padding:15px; border-radius:10px; border:1px solid var(--border); margin-top:10px; animation: fadeIn 0.3s;">
                    <div style="font-size:14px; font-weight:800; color:var(--success); margin-bottom:8px;">✅ Answer: ${String.fromCharCode(65+correctIdx)}) ${cleanMathText(correctAnsText)}</div>
                    <hr style="border:none; border-top:1px dashed var(--border); margin:10px 0;">
                    <div style="font-size:13px; color:var(--text-muted); line-height:1.5;">
                        ${solText ? `<b>💡 Detailed Solution:</b><br>${solText}` : ''}
                        ${aiBtnHtml}
                    </div>
                </div>
            </div>`;
        });
    }
    
    container.innerHTML = html;
    if(window.MathJax) { MathJax.typesetPromise([container]); }
}

function toggleNbSolution(id, btn) {
    const el = document.getElementById(id);
    if(el.style.display === 'none' || el.style.display === '') {
        el.style.display = 'block';
        btn.innerHTML = '🙈 Hide Solution';
    } else {
        el.style.display = 'none';
        btn.innerHTML = '👁️ Show Answer & Solution';
    }
}

window.checkNotebookInlineAns = function(el, qKey, selectedIdx, correctIdx, solId) {
    let parent = document.getElementById(`nb_opts_${qKey}`);
    if(parent.classList.contains('answered')) return; 
    
    parent.classList.add('answered');
    let options = parent.querySelectorAll('.nb-inline-opt');
    
    // Disable further clicks
    options.forEach(opt => {
        opt.style.pointerEvents = 'none';
        opt.style.opacity = '0.7';
    }); 
    
    el.style.opacity = '1';
    
    // Check answer correctness
    if (selectedIdx === correctIdx) {
        el.style.background = '#dcfce7';
        el.style.borderColor = '#16a34a';
        el.style.color = '#166534';
        if(window.confetti) confetti({particleCount: 40, spread: 50, origin: {y: 0.8}});
        showToast("Correct Answer! ✅", "success");
    } else {
        el.style.background = '#fee2e2';
        el.style.borderColor = '#dc2626';
        el.style.color = '#991b1b';
        showToast("Wrong Answer! ❌", "error");
        
        // Highlight the actual correct option
        let correctEl = options[correctIdx];
        if(correctEl) {
            correctEl.style.opacity = '1';
            correctEl.style.background = '#dcfce7';
            correctEl.style.borderColor = '#16a34a';
            correctEl.style.color = '#166534';
        }
    }
    
    // Auto open the solution box
    let solBox = document.getElementById(solId);
    if (solBox && (solBox.style.display === 'none' || solBox.style.display === '')) {
        solBox.style.display = 'block';
        let toggleBtn = solBox.previousElementSibling;
        if (toggleBtn && toggleBtn.tagName === 'BUTTON') {
            toggleBtn.innerHTML = '🙈 Hide Solution';
        }
    }
};

async function removeNotebookItem(key, type) {
    let storageKey = type === 'bookmarks' ? 'dsssb_bookmarks' : 'dsssb_mistakes';
    let dataStr = await getItemDB(storageKey);
    let data = dataStr ? JSON.parse(dataStr) : {};
    
    if(data[key]) {
        delete data[key];
        await setItemDB(storageKey, JSON.stringify(data));
        showToast("Removed from Notebook");
        renderNotebook(type);
    }
}

