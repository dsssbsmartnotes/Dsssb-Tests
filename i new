async function exportLocalBackup() {
    try {
        let btn = document.getElementById('exportBackupBtn');
        let origText = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Exporting...';
        btn.disabled = true;

        // 1. Prepare LocalStorage Data
        let lsData = {};
        const allowedLSKeys = [
            'dsssb_user_xp', 'streak', 'lastVisit', 'dsssb_base_xp', 
            'syllabusProgress', 'theme', 'my_target_name', 'my_target_date', 
            'dsssb_lucky_mock', 'rival_date', 'rival_name', 'rival_score'
        ];
        
        allowedLSKeys.forEach(k => {
            let v = localStorage.getItem(k);
            if (v !== null) lsData[k] = v;
        });

        // 2. Prepare IndexedDB Data
        let idbData = {};
        const db = await initDB();
        
        const tx = db.transaction(IDB_STORE, 'readonly');
        const store = tx.objectStore(IDB_STORE);
        
        // Manual implementation since IDB wrapper doesn't expose getAllKeys
        const keysReq = store.getAllKeys();
        const valsReq = store.getAll();
        
        const [keys, values] = await Promise.all([
            new Promise((res, rej) => { keysReq.onsuccess = () => res(keysReq.result); keysReq.onerror = () => rej(keysReq.error); }),
            new Promise((res, rej) => { valsReq.onsuccess = () => res(valsReq.result); valsReq.onerror = () => rej(valsReq.error); })
        ]);

        for (let i = 0; i < keys.length; i++) {
            let k = keys[i];
            // EXCLUDE heavy JSON caches, PRO metadata, and inbox to keep backup lightweight
            if (k.startsWith('cache_') || k.startsWith('pro_') || k.startsWith('dsssb_inbox_') || k.endsWith('_time')) continue;
            
            // Only include specific safe objects
            if (k === 'dsssb_bookmarks' || k === 'dsssb_mistakes' || k === 'savedTests' || 
                k.startsWith('dsssb_permanent_results_') || k === 'dsssb_unsynced_results' || 
                k.startsWith('dsssb_cbt_rank_v2_')) {
                idbData[k] = values[i];
            }
        }

        // 3. Construct Backup Object
        let backupObj = {
            metadata: {
                schemaVersion: "1.1",
                timestamp: Date.now(),
                userId: currentUserId,
                appVersion: APP_VERSION,
                idbRecords: Object.keys(idbData).length,
                lsRecords: Object.keys(lsData).length
            },
            idb: idbData,
            ls: lsData
        };

        // 3.5 Generate Integrity Hash
        let rawJsonStr = JSON.stringify(backupObj);
        const hashBuffer = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(rawJsonStr));
        const hashArray = Array.from(new Uint8Array(hashBuffer));
        const hashHex = hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
        
        backupObj.integrityHash = hashHex;

        // 4. Download File
        let finalJsonStr = JSON.stringify(backupObj);
        let blob = new Blob([finalJsonStr], { type: "application/json;charset=utf-8" });
        let url = URL.createObjectURL(blob);
        let a = document.createElement('a');
        a.href = url;
        let dateStr = new Date().toISOString().split('T')[0];
        a.download = `DSSSB_Backup_${dateStr}.dsssbbackup`;
        
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);

        // 5. Update UI
        setSafeData('dsssb_last_backup_date', Date.now());
        showToast("Backup Exported Successfully! ✅", "success");
        
        document.getElementById('lastBackupText').innerText = `Last backed up: Just Now`;
        checkBackupReminder();
        renderBackupInfo(backupObj);

        btn.innerHTML = origText;
        btn.disabled = false;

    } catch(err) {
        showToast("Backup Failed: " + err.message, "error");
        document.getElementById('exportBackupBtn').innerHTML = '<i class="fas fa-file-export"></i> Export Backup (.dsssbbackup)';
        document.getElementById('exportBackupBtn').disabled = false;
    }
}

async function freeUpLocalSpace() {
    if(!confirm("Clean up old test data to save space? Your scores and progress will NOT be deleted.")) return;

    const btn = document.getElementById('freeSpaceBtn');
    const origText = btn.innerHTML;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Cleaning...';
    btn.disabled = true;

    try {
        const db = await initDB();
        const tx = db.transaction(IDB_STORE, 'readwrite');
        const store = tx.objectStore(IDB_STORE);
        
        const keysReq = store.getAllKeys();
        const valsReq = store.getAll();
        
        const [keys, values] = await Promise.all([
            new Promise((res, rej) => { keysReq.onsuccess = () => res(keysReq.result); keysReq.onerror = () => rej(keysReq.error); }),
            new Promise((res, rej) => { valsReq.onsuccess = () => res(valsReq.result); valsReq.onerror = () => rej(valsReq.error); })
        ]);

        let cleanedCount = 0;
        const sixMonthsAgo = Date.now() - (180 * 24 * 60 * 60 * 1000);

        for (let i = 0; i < keys.length; i++) {
            let k = keys[i];
            if (k.startsWith('dsssb_offline_result_')) {
                try {
                    let data = JSON.parse(values[i]);
                    if (data.timestamp && data.timestamp < sixMonthsAgo) {
                        if (data.timePerQ || data.answers) {
                            delete data.timePerQ;
                            delete data.answers;
                            store.put(JSON.stringify(data), k);
                            cleanedCount++;
                        }
                    }
                } catch(e) {}
            } else if (k.startsWith('dsssb_permanent_results_')) {
                try {
                    let data = JSON.parse(values[i]);
                    let changed = false;
                    for (let testKey in data) {
                        if (data[testKey].timestamp && data[testKey].timestamp < sixMonthsAgo) {
                            if (data[testKey].timePerQ || data[testKey].answers) {
                                delete data[testKey].timePerQ;
                                delete data[testKey].answers;
                                changed = true;
                            }
                        }
                    }
                    if (changed) {
                        store.put(JSON.stringify(data), k);
                        cleanedCount++;
                    }
                } catch(e) {}
            }
        }
        
        showToast(`Cleaned up heavy data for ${cleanedCount} old tests! 🧹`, "success");
    } catch(err) {
        showToast("Cleanup Failed: " + err.message, "error");
    } finally {
        btn.innerHTML = origText;
        btn.disabled = false;
    }
}

