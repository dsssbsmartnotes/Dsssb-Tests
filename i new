// STEP 2A: Setup new account or perform automatic migration for legacy users
async function processAuthSetup() {
    const phone = document.getElementById('authPhone').value.trim();
    const name = document.getElementById('authRegName').value.trim();
    const pass = document.getElementById('authRegPass').value;
    const passConf = document.getElementById('authRegPassConf').value;

    if(name.length < 3) return showToast("Please enter your full name", "error");
    if(pass.length < 8) return showToast("Password must be at least 8 characters", "error");
    if(pass !== passConf) return showToast("Passwords do not match", "error");

    const btn = document.getElementById('btnAuthSetup');
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Securing...';
    btn.disabled = true;

    try {
        // Prevent duplicate creation via double check
        const snapCheck = await firebaseRead('dsssb_users_secure/' + phone);
        if (snapCheck.exists() && snapCheck.val().password_hash) {
            throw new Error("Account already secured. Please go back and login.");
        }

        const saltBuffer = await generateCryptoSalt();
        const hashBuffer = await hashPasswordSecure(pass, saltBuffer);
        
        const saltHex = bufferToHex(saltBuffer);
        const hashHex = bufferToHex(hashBuffer);
        const sessionToken = generateSessionToken();
        const now = Date.now();
        const sessionExpiry = now + (SESSION_DAYS * 24 * 60 * 60 * 1000);

        const secureNode = {
            display_name: name,
            password_hash: hashHex,
            salt: saltHex,
            session_token: sessionToken,
            session_created: now,
            session_expiry: sessionExpiry,
            last_login: now,
            created_at: now,
            updated_at: now,
            login_version: 1,
            status: "active"
        };

        // Write missing node strictly using merge-style UPDATE to preserve future schema additions
        await firebaseUpdate('dsssb_users_secure/' + phone, secureNode);
        
        saveLocalSession(phone, name, sessionToken, now, sessionExpiry);
        startApplication(); 
    } catch(err) {
        showToast("Error: " + err.message, "error");
    } finally {
        btn.innerHTML = 'CREATE ACCOUNT & SECURE LOGIN ➔';
        btn.disabled = false;
    }
}

// STEP 2B: Returning Secure User Login Validation
async function processAuthLogin() {
    const phone = document.getElementById('authPhone').value.trim();
    const pass = document.getElementById('authLoginPass').value;
    if(pass.length === 0) return showToast("Please enter your password", "warning");

    const btn = document.getElementById('btnAuthLogin');
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Verifying...';
    btn.disabled = true;

    try {
        if(!tempAuthData) throw new Error("Session state lost. Please try again.");
        if(tempAuthData.status && tempAuthData.status !== "active") throw new Error("Account is " + tempAuthData.status);

        const storedSaltBuffer = hexToBuffer(tempAuthData.salt);
        const inputHashBuffer = await hashPasswordSecure(pass, storedSaltBuffer);
        const inputHashHex = bufferToHex(inputHashBuffer);

        if(inputHashHex === tempAuthData.password_hash) {
            const sessionToken = generateSessionToken();
            const now = Date.now();
            const sessionExpiry = now + (SESSION_DAYS * 24 * 60 * 60 * 1000);

            // Update only specific session fields, avoiding overwrite of non-auth fields
            await firebaseUpdate('dsssb_users_secure/' + phone, {
                session_token: sessionToken,
                session_created: now,
                session_expiry: sessionExpiry,
                last_login: now,
                updated_at: now
            });

            let dName = tempAuthData.display_name || getSafeData('dsssb_user_name') || "Student";
            saveLocalSession(phone, dName, sessionToken, now, sessionExpiry);
            
            document.getElementById('authLoginPass').value = '';
            startApplication(); 
        } else {
            showToast("Incorrect Password", "error");
            document.getElementById('authLoginPass').value = '';
        }
    } catch(err) {
        showToast(err.message, "error");
    } finally {
        btn.innerHTML = 'LOGIN ➔';
        btn.disabled = false;
    }
}

function saveLocalSession(userId, userName, token, created, expiry) {
