// 🔥 PHASE 3.3: SMART DASHBOARD LOGIC (Zero Firebase Reads) 🔥
async function generateSmartDashboardStats(resultsObj, chartAverages, testCount, overallPercent) {
    try {
        // 1. Revision Due Feature
        let bmStr = await getItemDB('dsssb_bookmarks');
        let mkStr = await getItemDB('dsssb_mistakes');
        let bmCount = bmStr ? Object.keys(JSON.parse(bmStr)).length : 0;
        let mkCount = mkStr ? Object.keys(JSON.parse(mkStr)).length : 0;
        let totalRev = bmCount + mkCount;
        
        let revCard = document.getElementById('smartRevisionCard');
        if (revCard && totalRev > 0) {
            revCard.style.display = 'flex';
            document.getElementById('smartRevText').innerText = `${mkCount} Mistakes, ${bmCount} Saved`;
        }

        // 2. Continue Learning Feature (Finds exactly one unfinished mock)
        let foundUnfinished = null;
        for (let i = 0; i < Math.min(20, allTests.length); i++) { 
            let t = allTests[i];
            if(t.dbKey === 'auto_qod') continue;
            let savedStr = await getItemDB("dsssb_cbt_rank_v2_" + t.dbKey);
            if(savedStr) {
                let state = JSON.parse(savedStr);
                if(!state.submitted) {
                    let answered = state.answers ? state.answers.filter(a => a !== null).length : 0;
                    let total = state.answers ? state.answers.length : 1;
                    let pct = Math.round((answered/total)*100);
                    foundUnfinished = { testId: t.dbKey, title: t.title, answered, total, pct };
                    break;
                }
            }
        }
        
        let continueCard = document.getElementById('smartContinueCard');
        if (continueCard && foundUnfinished) {
            continueCard.style.display = 'flex';
            document.getElementById('smartContinueTitle').innerText = foundUnfinished.title;
            document.getElementById('smartContinueProgText').innerText = `${foundUnfinished.pct}% (${foundUnfinished.answered}/${foundUnfinished.total} Qs)`;
            document.getElementById('smartContinueProgFill').style.width = `${foundUnfinished.pct}%`;
            document.getElementById('smartContinueBtn').onclick = () => {
                let targetTest = allTests.find(t => t.dbKey === foundUnfinished.testId);
                if(targetTest) {
                    let pm = targetTest.pm !== undefined ? parseFloat(targetTest.pm) : 1;
                    let nm = targetTest.nm !== undefined ? parseFloat(targetTest.nm) : 0.25;
                    let isLocked = (targetTest.lock === false || targetTest.lock === "false") ? false : true;
                    let fileUrlEncoded = encodeURIComponent(`https://pyqnotes.netlify.app/tests/${targetTest.dbKey}.json`);
                    window.location.href = `cbt.html?testid=${encodeURIComponent(targetTest.dbKey)}&title=${encodeURIComponent(targetTest.title)}&time=${targetTest.time||120}&pm=${pm}&nm=${nm}&lock=${isLocked}&fileUrl=${fileUrlEncoded}&mode=exam`;
                }
            };
        } else if (continueCard) {
            continueCard.style.display = 'none';
        }

        // 3. Weak Subject Radar Feature
        let subjects = ['Maths', 'English', 'Hindi', 'GK', 'Reasoning'];
        let minScore = 101, maxScore = -1;
        let weakSub = "--", strongSub = "--";
        if (testCount > 0 && chartAverages && chartAverages.length === 5) {
            chartAverages.forEach((score, idx) => {
                if(score > maxScore && score > 0) { maxScore = score; strongSub = subjects[idx]; }
                if(score < minScore && score > 0) { minScore = score; weakSub = subjects[idx]; }
            });
        }
        document.getElementById('smartWeakSub').innerText = weakSub;
        document.getElementById('smartStrongSub').innerText = strongSub;

        // 4. Weekly Summary Feature
        let now = Date.now();
        let oneWeekAgo = now - (7 * 24 * 60 * 60 * 1000);
        let weeklyTests = Object.values(resultsObj).filter(r => {
            let t = r.timestamp || r.time || 0;
            return t >= oneWeekAgo && (r.userId === currentUserId || r.name === currentUser);
        });
        
        let wScore = 0, wCorrect = 0, wTotalQ = 0, wTime = 0;
        weeklyTests.forEach(r => {
            wScore += (parseFloat(r.score) || 0);
            wCorrect += (r.correct || 0);
            wTotalQ += ((r.correct || 0) + (r.wrong || 0) + (r.skipped || 0) || 20);
            wTime += (r.timeTaken || r.time || 0); 
        });
        
        let wAttempted = weeklyTests.length;
        let wAvgScore = wAttempted > 0 ? Math.round(wScore / wAttempted) : 0;
        let wAvgAcc = wTotalQ > 0 ? Math.round((wCorrect / wTotalQ) * 100) : 0;
        let wTimeHours = wTime > 0 ? (wTime / 3600).toFixed(1) : 0;
        
        document.getElementById('smartWkTests').innerText = wAttempted;
        document.getElementById('smartWkAvg').innerText = wAvgScore;
        document.getElementById('smartWkAcc').innerText = wAvgAcc + '%';
        document.getElementById('smartWkTime').innerText = wTimeHours + 'h';

        // 5. Exam Readiness Feature (Scaled Confidence Logic)
        let readiness = 0;
        if (testCount > 0) {
            let confidenceMultiplier = Math.min(1, testCount / 10); // Volume scaling
            readiness = Math.round(overallPercent * confidenceMultiplier);
        }
        document.getElementById('smartReadinessVal').innerText = readiness + '%';
        document.getElementById('smartReadinessFill').style.width = readiness + '%';
        
        if (readiness >= 75) {
             document.getElementById('smartReadinessVal').style.color = 'var(--success)';
             document.getElementById('smartReadinessFill').style.background = 'var(--success)';
        } else if (readiness >= 40) {
             document.getElementById('smartReadinessVal').style.color = 'var(--warning)';
             document.getElementById('smartReadinessFill').style.background = 'var(--warning)';
        } else {
             document.getElementById('smartReadinessVal').style.color = 'var(--danger)';
             document.getElementById('smartReadinessFill').style.background = 'var(--danger)';
        }

        // 🔥 Trigger Priority Engine after stats are generated 🔥
        runSmartPriorityEngine();

    } catch (err) {
        console.log("Smart Dashboard Background Check Safe Ignored", err);
    }
}

