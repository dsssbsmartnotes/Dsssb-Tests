async function silentSessionValidation(phone, localToken) {
    try {
        const snap = await firebaseRead('dsssb_users_secure/' + phone + '/session_token');
        if (snap.exists() && snap.val() === localToken) {
            const now = Date.now();
            const sessionExpiry = now + (SESSION_DAYS * 24 * 60 * 60 * 1000);
            await firebaseUpdate('dsssb_users_secure/' + phone, {
                last_login: now,
                updated_at: now
            });
            let sessionStr = getSafeData('dsssb_secure_session');
            if(sessionStr) {
                let sess = JSON.parse(sessionStr);
                sess.last_login = now;
                sess.session_expiry = sessionExpiry;
                setSafeData('dsssb_secure_session', JSON.stringify(sess));
            }
        } else {
            // Token is invalid/revoked globally, force logout
            removeSafeData('dsssb_secure_session');
            window.location.reload();
        }
    } catch(e) {
        // Ignored. Connection failure, local token remains trusted until expired.
    }
}

