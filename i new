async function analyzeStudyHistory() {
    try {
        let tId = getSafeData('dsssb_user_id') || "guest";
        let resStr = await getItemDB('dsssb_permanent_results_' + tId);
        let results = resStr ? JSON.parse(resStr) : {};
        let totalTests = 0, totalScore = 0, totalAcc = 0, totalTime = 0;
        let daysSet = new Set();
        
        Object.values(results).forEach(r => {
            if (r) {
                totalTests++;
                totalScore += (Number(r.score) || 0);
                totalAcc += (Number(r.accuracy) || 0);
                totalTime += (Number(r.time || r.timeTaken) || 0);
                let tStamp = r.timestamp || r.time;
                if (tStamp) daysSet.add(new Date(Number(tStamp)).toDateString());
            }
        });
        
        let avgScore = totalTests > 0 ? (totalScore / totalTests) : 0;
        let avgAcc = totalTests > 0 ? (totalAcc / totalTests) : 0;
        let avgTimeMins = totalTests > 0 ? (totalTime / 60 / totalTests) : 0;
        
        return {
            totalTests: totalTests,
            daysStudied: daysSet.size,
            totalQuestionsSolved: totalTests * 20,
            averageScore: Number(avgScore.toFixed(2)),
            averageAccuracy: Number(avgAcc.toFixed(2)),
            averageStudyMinutes: Number(avgTimeMins.toFixed(2))
        };
    } catch (e) {
        return { totalTests: 0, daysStudied: 0, totalQuestionsSolved: 0, averageScore: 0, averageAccuracy: 0, averageStudyMinutes: 0 };
    }
}

async function analyzePracticeHistory() {
    try {
        let tId = getSafeData('dsssb_user_id') || "guest";
        let resStr = await getItemDB('dsssb_permanent_results_' + tId);
        let results = resStr ? JSON.parse(resStr) : {};
        let recentScores = [];
        let completedTests = 0;
        
        Object.values(results).forEach(r => {
            if (r && r.score !== undefined) {
                completedTests++;
                recentScores.push(Number(r.score) || 0);
            }
        });
        
        return {
            totalTests: completedTests,
            highestScore: recentScores.length > 0 ? Math.max(...recentScores) : 0,
            lowestScore: recentScores.length > 0 ? Math.min(...recentScores) : 0,
            recentTrend: recentScores.slice(-5)
        };
    } catch (e) {
        return { totalTests: 0, highestScore: 0, lowestScore: 0, recentTrend: [] };
    }
}

async function analyzeSubjectPerformance() {
    try {
        let anaStr = await getItemDB('dsssb_analysis_data');
        let ana = anaStr ? JSON.parse(anaStr) : {};
        let performance = {};
        
        if (ana && ana.topicPerformance) {
            for (let top in ana.topicPerformance) {
                let s = ana.topicPerformance[top];
                let att = (Number(s.c) || 0) + (Number(s.w) || 0);
                let acc = att > 0 ? ((Number(s.c) || 0) / att) * 100 : 0;
                performance[top] = {
                    attempted: att,
                    correct: Number(s.c) || 0,
                    wrong: Number(s.w) || 0,
                    accuracy: Number(acc.toFixed(2)),
                    improvement: 0,
                    trend: acc >= 70 ? "Up" : (acc <= 40 ? "Down" : "Stable")
                };
            }
        }
        return performance;
    } catch (e) {
        return {};
    }
}

async function analyzeWeeklyConsistency() {
    try {
        let streak = parseInt(getSafeData('streak') || 0);
        let bestStreak = parseInt(getSafeData('bestStreak') || streak);
        
        if (streak > bestStreak) {
            bestStreak = streak;
            setSafeData('bestStreak', bestStreak);
        }
        
        return {
            daysActive: streak,
            currentStreak: streak,
            bestStreak: bestStreak,
            studyMinutes: streak * 30,
            consistencyScore: Math.min(100, streak * 10)
        };
    } catch (e) {
        return { daysActive: 0, currentStreak: 0, bestStreak: 0, studyMinutes: 0, consistencyScore: 0 };
    }
}

async function analyzeRevisionHistory() {
    try {
        let mkStr = await getItemDB('dsssb_mistakes');
        let mistakes = mkStr ? JSON.parse(mkStr) : {};
        let topics = new Set();
        let revCount = 0;
        
        Object.values(mistakes).forEach(m => {
            if (m) {
                revCount++;
                if (m.topic) topics.add(m.topic);
                else if (m.section) topics.add(m.section);
            }
        });
        
        return {
            topicsRevised: 0,
            revisionCount: revCount,
            lastRevisionDate: new Date().toDateString(),
            pendingRevision: Array.from(topics)
        };
    } catch (e) {
        return { topicsRevised: 0, revisionCount: 0, lastRevisionDate: "N/A", pendingRevision: [] };
    }
}

async function calculateRevisionPriority() {
    try {
        let history = await analyzeRevisionHistory();
        let perf = await analyzeSubjectPerformance();
        
        let high = [], medium = [], low = [];
        let topics = Object.keys(perf);
        
        topics.forEach(top => {
            let acc = perf[top].accuracy || 0;
            if (acc < 40) high.push(top);
            else if (acc < 70) medium.push(top);
            else low.push(top);
        });

        let pending = history.pendingRevision || [];
        pending.forEach(p => {
            if (!high.includes(p) && !medium.includes(p) && !low.includes(p)) {
                medium.push(p);
            }
        });

        return { high, medium, low };
    } catch (e) {
        return { high: [], medium: [], low: [] };
    }
}

async function calculateStudyConsistency() {
    try {
        let weekly = await analyzeWeeklyConsistency();
        let score = weekly.consistencyScore || 0;
        let level = score >= 70 ? "High" : (score >= 40 ? "Medium" : "Low");
        
        return { consistencyScore: score, consistencyLevel: level };
    } catch (e) {
        return { consistencyScore: 0, consistencyLevel: "Low" };
    }
}

async function calculateExamReadiness() {
    try {
        let study = await analyzeStudyHistory();
        let cons = await calculateStudyConsistency();
        
        let accScore = (study.averageAccuracy || 0) * 0.6;
        let consScore = (cons.consistencyScore || 0) * 0.4;
        let total = Math.min(100, accScore + consScore);
        
        return { readinessScore: Math.round(total) };
    } catch (e) {
        return { readinessScore: 0 };
    }
}

async function generateDashboardRecommendations() {
    try {
        let priority = await calculateRevisionPriority();
        let study = await analyzeStudyHistory();
        
        let weakTopic = priority.high.length > 0 ? priority.high[0] : (priority.medium.length > 0 ? priority.medium[0] : "All Subjects");
        
        return {
            todayTarget: study.totalTests === 0 ? "Attempt your first Mock Test" : "Complete 1 Mock Test",
            tomorrowTarget: "Revise " + weakTopic,
            recommendedSubject: weakTopic,
            recommendedMock: "Mock Test on " + weakTopic,
            recommendedNotebook: "Mistake Book",
            recommendedRevision: priority.high.join(", ") || "General Revision"
        };
    } catch (e) {
        return { todayTarget: "N/A", tomorrowTarget: "N/A", recommendedSubject: "N/A", recommendedMock: "N/A", recommendedNotebook: "N/A", recommendedRevision: "N/A" };
    }
}

async function generateDashboardSummary() {
    try {
        let study = await analyzeStudyHistory();
        let cons = await calculateStudyConsistency();
        let priority = await calculateRevisionPriority();
        
        let weakTopic = priority.high.length > 0 ? priority.high[0] : (priority.medium.length > 0 ? priority.medium[0] : "specific concepts");
        
        let summaryText = `You have maintained a ${cons.consistencyLevel.toLowerCase()} study consistency so far. `;
        if (study.totalTests > 0) {
            summaryText += `You have completed ${study.totalTests} tests, achieving an average accuracy of ${study.averageAccuracy}%. `;
            if (priority.high.length > 0) {
                summaryText += `Your current focus should be on ${weakTopic} as it requires immediate revision.`;
            } else {
                summaryText += `Your performance is stable across most subjects. Keep practicing!`;
            }
        } else {
            summaryText += `Start your journey by attempting a mock test to establish your baseline readiness.`;
        }
        
        return { summaryInsight: summaryText.trim() };
    } catch (e) {
        return { summaryInsight: "Dashboard insights are currently unavailable." };
    }
}
function createDashboardAIEngine(appOfflineData) {
    if (!appOfflineData || typeof appOfflineData !== 'object') {
        return { error: true, message: "Invalid data payload provided." };
    }

    let studyAnalysis = analyzeStudyHistory(appOfflineData.studyHistory);
    let practiceAnalysis = analyzePracticeHistory(appOfflineData.practiceHistory);
    let subjectAnalysis = analyzeSubjectPerformance(appOfflineData.subjectPerformance);
    let weeklyConsistency = analyzeWeeklyConsistency(appOfflineData.weeklyLog);
    let revisionStatus = analyzeRevisionHistory(appOfflineData.revisionQueue);
    
    let consistencyCalc = calculateStudyConsistency(appOfflineData.weeklyLog);
    let revisionPriority = calculateRevisionPriority(appOfflineData.priorityData);
    let readinessCalc = calculateExamReadiness(appOfflineData.practiceHistory, appOfflineData.weeklyLog);

    let coreEngineData = {
        study: studyAnalysis,
        practice: practiceAnalysis,
        subjects: subjectAnalysis,
        activity: weeklyConsistency,
        pendingRevisions: revisionStatus,
        consistency: consistencyCalc,
        revision: revisionPriority,
        readiness: readinessCalc
    };

   let recommendations = generateDashboardRecommendations(coreEngineData);
    let summary = generateDashboardSummary(coreEngineData);

    return {
        engineData: coreEngineData,
        recommendations: recommendations,
        summary: summary
    };
}

