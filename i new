        <script>
        (function initMasterAIEcosystem() {
            async function syncEcosystem() {
                try {
                    let tId = (typeof getSafeData === 'function' ? getSafeData('dsssb_user_id') : null) || "guest";
                    
                    let anaStr = typeof getItemDB === 'function' ? await getItemDB('dsssb_analysis_data') : null;
                    let ana = anaStr ? JSON.parse(anaStr) : {};
                    let cbtAI = ana.latestAIReport || null;

                    // 🚀 MASTER FIX: Scan Live Records so Growth is instantly captured
                    let results = {};
                    let resStr = typeof getItemDB === 'function' ? await getItemDB('dsssb_permanent_results_' + tId) : null;
                    if(resStr) Object.assign(results, JSON.parse(resStr));

                    for(let i=0; i<localStorage.length; i++) {
                        let key = localStorage.key(i);
                        if(key && key.startsWith('dsssb_cbt_rank_v2_') && key.endsWith('_final')) {
                            try {
                                let tData = JSON.parse(localStorage.getItem(key));
                                let testId = key.replace('dsssb_cbt_rank_v2_', '').replace('_final', '');
                                let tTime = tData.timestamp || tData.time || Date.now();
                                results[testId + '_' + tTime] = {
                                    testId: testId,
                                    score: tData.score || 0,
                                    accuracy: tData.accuracy || 0,
                                    timeTaken: tData.timeTaken || 1200,
                                    timestamp: tTime,
                                    correct: tData.correct || 0,
                                    wrong: tData.wrong || 0,
                                    skipped: tData.skipped || 0
                                };
                            } catch(e){}
                        }
                    }

                    let testArr = Object.values(results).filter(r => r && r.score !== undefined).sort((a,b) => (Number(a.timestamp || a.time) || 0) - (Number(b.timestamp || b.time) || 0));
                    
                    let bestTest = null, worstTest = null, latestTest = null;
                    let trendProgress = "Stable ⚖️";
                    
                    if (testArr.length > 0) {
                        latestTest = testArr[testArr.length - 1];
                        bestTest = testArr.reduce((prev, curr) => (Number(curr.score) > Number(prev.score) ? curr : prev));
                        worstTest = testArr.reduce((prev, curr) => (Number(curr.score) < Number(prev.score) ? curr : prev));
                        
                        if (testArr.length >= 3) {
                            let mid = Math.floor(testArr.length / 2);
                            let firstHalf = testArr.slice(0, mid).reduce((sum, t) => sum + Number(t.score), 0) / mid;
                            let secondHalf = testArr.slice(mid).reduce((sum, t) => sum + Number(t.score), 0) / (testArr.length - mid);
                            if (secondHalf > firstHalf + 2) trendProgress = "Improving 📈";
                            else if (secondHalf < firstHalf - 2) trendProgress = "Declining 📉";
                        }
                    }

                    // 4. 🚀 Data Merging & Strict Core Subjects (Real Exam Feel)
                    const coreSubjects = ["Maths", "English", "Hindi", "GK", "Reasoning"];
                    
                    // Helper to snap random tags to Core Subjects
                    function snapToCore(subj) {
                        if(!subj) return "GK";
                        let s = subj.toLowerCase();
                        if (s.includes("math") || s.includes("quant") || s.includes("numerical")) return "Maths";
                        if (s.includes("eng")) return "English";
                        if (s.includes("hin")) return "Hindi";
                        if (s.includes("reasoning") || s.includes("mental") || s.includes("intel")) return "Reasoning";
                        return "GK"; // Default catch-all for GS, GA, Current Affairs etc.
                    }

                    // Raw subjects from AI
                    let rawWSubjects = cbtAI && cbtAI.weakSubjects && cbtAI.weakSubjects.length > 0 ? cbtAI.weakSubjects : ["GK", "Maths"];
                    let rawSSubjects = cbtAI && cbtAI.strongSubjects && cbtAI.strongSubjects.length > 0 ? cbtAI.strongSubjects : ["Reasoning", "English"];

                    // Convert and Dedup to exact 5 Core Subjects
                    let wSubjects = [...new Set(rawWSubjects.map(snapToCore))];
                    let sSubjects = [...new Set(rawSSubjects.map(snapToCore))];

                    // Fallback to ensure there's always a valid subject if lists become empty after mapping
                    if(wSubjects.length === 0) wSubjects = ["Maths", "GK"];
                    if(sSubjects.length === 0) sSubjects = ["Reasoning", "Hindi"];

                    let readiness = cbtAI ? cbtAI.readinessScore : (testArr.length > 0 ? latestTest.score : 0);
                    
                    let dynamicMockLevel = readiness < 45 ? "Foundation Level" : (readiness < 75 ? "Target Level" : "Advanced Level");
                    let dynamicMockTarget = wSubjects[0];

                    // 🚀 LIVE WEEKLY GROWTH FIX
                    let oneWeekAgo = Date.now() - (7 * 24 * 60 * 60 * 1000);
                    let weeklyTests = testArr.filter(r => (Number(r.timestamp || r.time) || 0) >= oneWeekAgo);

                   // 🚀 100% LIVE AI SUMMARY FIX: Purane Cache ko ignore karo aur hamesha Live Data dikhao
                    let finalSummaryText = "";
                    if (testArr.length === 0) {
                        finalSummaryText = "You haven't completed any tests yet. Start your first mock test to unlock your AI Readiness Report!";
                    } else {
                        // Ye line har baar fresh testArr.length calculate karegi!
                        finalSummaryText = `Great going! You've successfully completed <b>${testArr.length} test${testArr.length > 1 ? 's' : ''}</b>. Your current readiness is at <b>${readiness}%</b> and your progress trend is <b>${trendProgress}</b>. Keep focusing on <b>${wSubjects[0]}</b> to boost your rank! 🚀`;
                    }

                    window.dashboardAIAnalysis = {
                            tomorrowTarget: "Revise " + (wSubjects[1] || wSubjects[0]),
                            recommendedSubject: wSubjects[0],
                            recommendedMock: `${dynamicMockLevel} - ${dynamicMockTarget}`,
                            recommendedRevision: wSubjects.slice(0, 3).join(", ")
                        },
                        studyConsistency: {
                            consistencyScore: Math.min(100, testArr.length * 5),
                            currentStreak: typeof getSafeData === 'function' ? parseInt(getSafeData('streak')||0) : 0,
                            bestStreak: typeof getSafeData === 'function' ? parseInt(getSafeData('bestStreak')||0) : 0,
                            daysActive: testArr.length
                        },
                        weeklyPerformance: {
                            studyMinutes: weeklyTests.reduce((sum, r) => sum + Math.round((r.timeTaken || 1200)/60), 0),
                            questionsSolved: weeklyTests.reduce((sum, r) => sum + ((r.correct||0) + (r.wrong||0) + (r.skipped||0) || 20), 0),
                            testsCompleted: weeklyTests.length
                        },
                        revisionPriority: {
                            high: wSubjects,
                            medium: [],
                            low: sSubjects
                        }
                    };

                    let continueBtn = document.getElementById('smartContinueBtn');
                    if (continueBtn && !document.getElementById('smartContinueAiHint')) {
                        let hint = document.createElement('div');
                        hint.id = 'smartContinueAiHint';
                        hint.style = "font-size:11px; color:var(--text-muted); margin-top:10px; text-align:center; font-weight:600; animation: fadeIn 1s ease-in;";
                        hint.innerHTML = `<i class="fas fa-brain" style="color:var(--primary);"></i> AI Suggests: <b>${wSubjects[0]}</b>`;
                        continueBtn.parentNode.appendChild(hint);
                    }

                } catch (e) {
                    console.error("Master AI Integration Offline Sync Error:", e);
                }
            }

            // Sync on load and periodically via local cache
            syncEcosystem();
            setInterval(syncEcosystem, 5000);
        })();
