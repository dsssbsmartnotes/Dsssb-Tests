        let now = Date.now();
        
        if (cachedStr && cacheTime && (now - cacheTime < 60 * 60 * 1000)) {
            if (navigator.onLine && url) {
                fetch(url).then(res => res.json()).then(data => {
                    setItemDB(cacheKey, JSON.stringify(data));
                    setItemDB(cacheKey + '_time', Date.now());
                }).catch(e => console.log("BG sync failed for", cacheKey));
            }
            return JSON.parse(cachedStr);
        }
        
