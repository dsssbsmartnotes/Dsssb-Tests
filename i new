    if (discoveredData && discoveredData.indexedDB && discoveredData.indexedDB['dsssb_bookmarks']) {
        bookmarks = discoveredData.indexedDB['dsssb_bookmarks'];
    }
    
    Object.keys(bookmarks).forEach(k => {
