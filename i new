window.toggleMergeTest = function(dbKey, isChecked) {
    if(isChecked) {
        let t = allTests.find(x => x.dbKey === dbKey);
        if(t) window.selectedMergeTests.push(t);
    } else {
        window.selectedMergeTests = window.selectedMergeTests.filter(x => x.dbKey !== dbKey);
    }
    document.getElementById('mergeCount').innerText = `${window.selectedMergeTests.length} Selected`;
};

