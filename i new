let currentLuckyMockData = null;

function initLuckyMock(weakSubject) {
    const todayStr = new Date().toDateString();
    let yest = new Date(); yest.setDate(yest.getDate() - 1);
    const yestStr = yest.toDateString();
    
    let savedLuckyData = getSafeData('dsssb_lucky_mock');
    let state = { mockId: "", date: "", completed: false, reason: "", theme: "", title: "", streak: 0, history: [] };

    if (savedLuckyData) {
        try {
            let parsed = JSON.parse(savedLuckyData);
            // Migrate history array if missing from old version
            if(!parsed.history) parsed.history = []; 
            state = parsed;
            
            // Streak Check: If generated date is older than yesterday, reset streak
            if (state.date !== todayStr && state.date !== yestStr) {
                state.streak = 0; 
            }
            
            if (state.date === todayStr) {
                currentLuckyMockData = state;
                checkLuckyMockCompletion();
                updateLuckyFabUI();
                return; // Already generated for today
            }
        } catch(e) {}
    }

    // --- SMART MYSTERY DAY ENGINE ---
    let dayIndex = new Date().getDay();
    let themes = [
        { name: "Surprise Challenge", key: "surprise" },       // 0: Sun
        { name: "Weak Subject Challenge", key: "weak" },       // 1: Mon
        { name: "Never Attempted", key: "never" },             // 2: Tue
        { name: "Revision Day", key: "revision" },             // 3: Wed
        { name: "Random Explorer", key: "random" },            // 4: Thu
        { name: "High Difficulty", key: "hard" },              // 5: Fri
        { name: "Strong Subject Challenge", key: "strong" }    // 6: Sat
    ];
    let todayTheme = themes[dayIndex];

    // --- MOCK SELECTION LOGIC ---
    let validTests = allTests.filter(t => t.dbKey !== 'auto_qod' && (!t.lock || isPro));
    if(validTests.length === 0) return;

    let candidateTests = [];
    let reasonText = "";
    
    let strongSubEl = document.getElementById('smartStrongSub');
    let strongSubject = strongSubEl && strongSubEl.innerText !== "--" ? strongSubEl.innerText : "";

    switch(todayTheme.key) {
        case "weak":
            candidateTests = validTests.filter(t => weakSubject && ((t.category||"").toLowerCase().includes(weakSubject.toLowerCase()) || (t.title||"").toLowerCase().includes(weakSubject.toLowerCase())));
            reasonText = `Targeting your weakness in ${weakSubject}.`;
            break;
        case "strong":
            candidateTests = validTests.filter(t => strongSubject && ((t.category||"").toLowerCase().includes(strongSubject.toLowerCase()) || (t.title||"").toLowerCase().includes(strongSubject.toLowerCase())));
            reasonText = `Maximize your strengths in ${strongSubject}.`;
            break;
        case "never":
            candidateTests = validTests.filter(t => !attemptedTestIds.has(t.dbKey));
            reasonText = "Fresh content you haven't seen yet.";
            break;
        case "revision":
            let oneWeekAgo = Date.now() - (7 * 24 * 60 * 60 * 1000);
            candidateTests = validTests.filter(t => attemptedTestIds.has(t.dbKey) && attemptedTestIds.get(t.dbKey) < oneWeekAgo);
            reasonText = "Perfect time to brush up on old concepts.";
            break;
        case "hard":
            candidateTests = validTests.filter(t => (t.tags||"").toLowerCase().includes("hard"));
            reasonText = "Push your limits with a tough challenge.";
            break;
        default:
            candidateTests = validTests;
            reasonText = "A random pick curated just for you.";
    }

    // Fallback if theme filter yields 0 tests
    if (candidateTests.length === 0) {
        candidateTests = validTests;
        reasonText = "Handpicked challenge for today.";
    }

    // --- ANTI-REPETITION (Last 30 Mocks) ---
    let nonRepeated = candidateTests.filter(t => !state.history.includes(t.dbKey));
    if (nonRepeated.length > 0) {
        candidateTests = nonRepeated;
    } // else, fallback to allowing repetition if exhausted

    // Pick final mock
    let selectedTest = candidateTests[Math.floor(Math.random() * candidateTests.length)];

    // Update History (Keep max 30)
    state.history.push(selectedTest.dbKey);
    if (state.history.length > 30) state.history.shift();

    currentLuckyMockData = {
        mockId: selectedTest.dbKey,
        date: todayStr,
        completed: false,
        reason: reasonText,
        theme: todayTheme.name,
        title: selectedTest.title,
        streak: state.streak,
        history: state.history
    };

    setSafeData('dsssb_lucky_mock', JSON.stringify(currentLuckyMockData));
    updateLuckyFabUI();
}

