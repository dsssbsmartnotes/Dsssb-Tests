            if (typeof triggerHaptic === 'function') triggerHaptic();
            
            if (content.style.display === 'none' || content.style.display === '') {
                content.style.display = 'block';
                icon.style.transform = 'rotate(180deg)'; // Arrow up 🔼
            } else {
                content.style.display = 'none';
                icon.style.transform = 'rotate(0deg)'; // Arrow down 🔽
            }
        };

       // 🚀 MASTER AI TARGET LAUNCHER: Real-Time Fetching Implementation
        window.launchAITargetMock = async function(actionType, target) {
            if (typeof triggerHaptic === 'function') triggerHaptic();
            
            let btnStr = actionType === 'revision' ? "Revision" : target;
            showToast("Generating Smart Mock for: " + btnStr + " ⏳", "info");
            
            try {
                let cbtQuestions = [];
                let title = target || "AI Targeted Mock";
                
                // 🚀 FAST FETCH: GitHub se Live Questions Uthayega
                if (typeof allTests !== 'undefined' && Array.isArray(allTests) && allTests.length > 0) {
                    let relevantTests = allTests;
                    
                    if (actionType === 'subject' && target && target !== 'Mix') {
                        relevantTests = allTests.filter(t => {
                            let searchStr = ((t.title||"") + " " + (t.category||"") + " " + (t.tags||"")).toLowerCase();
                            return searchStr.includes(target.toLowerCase()) || searchStr.includes('full');
                        });
                    }
                    
                    relevantTests = relevantTests.sort(() => 0.5 - Math.random()).slice(0, 10);
                    
                    let fetchPromises = relevantTests.map(t => 
                        fetch(`https://raw.githubusercontent.com/amit-cbt-admin/Dsssb-Tests/main/tests/${t.dbKey}.json`)
                        .then(res => res.ok ? res.json() : null).catch(() => null)
                    );

                    let fetchedDataArray = await Promise.all(fetchPromises);
                    
                    fetchedDataArray.forEach((testQs) => {
                        if (testQs && Array.isArray(testQs)) {
                            testQs.forEach((q) => {
                                let qSubject = (q.section || "General").trim();
                                if (actionType === 'subject' && target && target !== 'Mix') {
                                    if (qSubject.toLowerCase() === target.toLowerCase()) {
                                        cbtQuestions.push(q);
                                    }
                                } else {
                                    cbtQuestions.push(q); // Revision aur Daily Mix ke liye sab kuch le lega
                                }
                            });
                        }
                    });
                }

                if (cbtQuestions.length === 0) {
                    showToast("Not enough questions found for " + target, "warning");
                    return;
                }

                // Shuffle karke top 20 questions filter karna
                cbtQuestions.sort(() => Math.random() - 0.5);
                cbtQuestions = cbtQuestions.slice(0, 20);

                if (actionType === 'subject') title = target + " Focus Mock";
                else if (actionType === 'revision') title = "Smart Revision Challenge";
                else title = "Daily Adaptive Mix";

                const customMockPayload = {
                    testId: "ai_auto_mock_" + Date.now(),
                    title: `🤖 AI Coach: ${title}`,
                    duration: cbtQuestions.length * 1, // 1 min per question
                    totalMarks: cbtQuestions.length,
                    positiveMarks: 1,
                    negativeMarks: 0.25,
                    questionCount: cbtQuestions.length,
                    questions: cbtQuestions,
                    languages: ["English", "Hindi"], 
                    defaultLanguage: "English", 
                    runtimeQuestionReferences: cbtQuestions.map(q => q._key || q.id || Math.random().toString(36)) 
                };

                // Inject mock deeply into memory
                if (typeof setItemDB === 'function') {
                    await setItemDB(customMockPayload.testId, JSON.stringify(customMockPayload));
                }
                localStorage.setItem('pyq_active_smart_mock', JSON.stringify(customMockPayload));
                
                // Boom! Final redirect!
                window.location.href = `cbt.html?testId=${customMockPayload.testId}&mode=smart_mock`;

            } catch(e) {
                console.error("AI Launch Error:", e);
                showToast("Network error while generating AI Mock.", "error");
            }
        };

