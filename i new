// --- REUSABLE OFFLINE WRAPPERS (Replaced Firebase) ---
async function firebaseRead(path) {
    let data = await getItemDB(path);
    return { exists: () => !!data, val: () => data ? JSON.parse(data) : null };
}
async function firebaseWrite(path, data) {
    await setItemDB(path, JSON.stringify(data));
}
async function firebaseUpdate(path, data) {
    let existing = await getItemDB(path);
    let parsed = existing ? JSON.parse(existing) : {};
    let merged = { ...parsed, ...data };
    await setItemDB(path, JSON.stringify(merged));
}
async function firebaseDelete(path) {
    await removeItemDB(path);
}

// --- WEB CRYPTO API (PBKDF2 HASHING) ---
async function generateCryptoSalt() {
    return crypto.getRandomValues(new Uint8Array(16));
}

async function hashPasswordSecure(password, saltUint8) {
    const enc = new TextEncoder();
    const keyMaterial = await crypto.subtle.importKey(
        "raw", enc.encode(password), {name: "PBKDF2"}, false, ["deriveBits"]
    );
    const hashBuffer = await crypto.subtle.deriveBits(
        { name: "PBKDF2", salt: saltUint8, iterations: 100000, hash: "SHA-256" },
        keyMaterial, 256
    );
    return new Uint8Array(hashBuffer);
}

function bufferToHex(buffer) {
    return Array.from(buffer).map(b => b.toString(16).padStart(2, '0')).join('');
}

function hexToBuffer(hex) {
    const bytes = new Uint8Array(Math.ceil(hex.length / 2));
    for (let i = 0; i < bytes.length; i++) bytes[i] = parseInt(hex.substr(i * 2, 2), 16);
    return bytes;
}

function generateSessionToken() {
    return 'sess_' + Date.now() + '_' + Math.random().toString(36).substr(2, 12);
}

