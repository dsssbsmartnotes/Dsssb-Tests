/* =======================================================
   🔥 INDEXED DB ENGINE (FOR UNLIMITED OFFLINE STORAGE) 🔥
   ======================================================= */
const IDB_NAME = 'PYQNotes_CBT_DB';
const IDB_STORE = 'Store';

const initDB = () => new Promise((res, rej) => {
    const req = indexedDB.open(IDB_NAME, 1);
    req.onupgradeneeded = e => e.target.result.createObjectStore(IDB_STORE);
    req.onsuccess = e => res(e.target.result);
    req.onerror = e => rej(e.target.error);
});

async function setItemDB(key, val) {
    try {
        const db = await initDB();
        const tx = db.transaction(IDB_STORE, 'readwrite');
        tx.objectStore(IDB_STORE).put(val, key);
        return new Promise((res, rej) => { tx.oncomplete = () => res(true); tx.onerror = () => rej(tx.error); });
    } catch(e) {
        try { localStorage.setItem(key, val); } catch(e2) {} 
    }
}

async function getItemDB(key) {
    try {
        const db = await initDB();
        const tx = db.transaction(IDB_STORE, 'readonly');
        const req = tx.objectStore(IDB_STORE).get(key);
        return new Promise((res, rej) => {
            req.onsuccess = () => res(req.result); 
            req.onerror = () => rej(req.error);
        });
    } catch(e) {
        try { return localStorage.getItem(key); } catch(e2) { return null; } 
    }
}

async function removeItemDB(key) {
    try {
        const db = await initDB();
        const tx = db.transaction(IDB_STORE, 'readwrite');
        tx.objectStore(IDB_STORE).delete(key);
        return new Promise((res, rej) => { tx.oncomplete = () => res(true); tx.onerror = () => rej(tx.error); });
    } catch(e) {
        try { localStorage.removeItem(key); } catch(e2) {}
    }
}

// 🔥 BUG FIX: Clean MathText added for proper equation rendering in Dashboard Notebook 🔥
function cleanMathText(str) {
    if(!str || typeof str !== 'string') return str;
    let s = str;
    s = s.replace(/\\\\([a-zA-Z])/g, '\\$1');
    s = s.replace(/\bfrac\s*(\d+)\s*\/?\s*(\d+)\b/g, '\\frac{$1}{$2}');
    s = s.replace(/(^|[^a-zA-Z\\&])frac{/g, '$1\\frac{'); 
    s = s.replace(/(^|[^a-zA-Z\\&])(pi|theta|alpha)\b/g, '$1\\$2');
    s = s.replace(/(^|[^a-zA-Z\\&])pir\^/g, '$1\\pi r^');
    s = s.replace(/(^|[^a-zA-Z\\&])times(?=[a-zA-Z0-9({]|$)/g, '$1\\times ');
    const safeMathBlock = (match, inner) => {
        let processedInner = inner;
        if (processedInner.includes('&') && !processedInner.includes('\\begin')) {
            processedInner = processedInner.replace(/([^\\]|^)&/g, '$1\\&'); 
        }
        if (match.startsWith('$$')) return '$$' + processedInner + '$$';
        if (match.startsWith('\\[')) return '\\[' + processedInner + '\\]';
        if (match.startsWith('\\(')) return '\\(' + processedInner + '\\)';
        return '$' + processedInner + '$';
    };
    s = s.replace(/\$\$([\s\S]*?)\$\$/g, safeMathBlock);
    s = s.replace(/\$([^$]+)\$/g, safeMathBlock);
    s = s.replace(/\\\[([\s\S]*?)\\\]/g, safeMathBlock);
    s = s.replace(/\\\(([\s\S]*?)\\\)/g, safeMathBlock);
    return s;
}

