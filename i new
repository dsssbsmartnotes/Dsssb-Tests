function calculateRuntimeMockStatistics(runtimeReferences) {
    let stats = { hardCount: 0, mediumCount: 0, easyCount: 0, validRefs: 0 };
    if (!Array.isArray(runtimeReferences)) return stats;
    
    runtimeReferences.forEach(r => {
        if (!r) return;
        stats.validRefs++;
        let d = String(r.difficulty || "").toLowerCase();
        if (d.includes('hard')) stats.hardCount++;
        else if (d.includes('easy')) stats.easyCount++;
        else stats.mediumCount++;
    });
    return stats;
}

function prepareRuntimeQuestionList(blueprint) {
    if (!blueprint || !Array.isArray(blueprint.runtimeReferences)) return [];
    return blueprint.runtimeReferences; // Never copy objects, pass references only
}

function validateRuntimeMock(mock) {
    if (!mock || typeof mock !== 'object') return false;
    if (!Array.isArray(mock.runtimeQuestionReferences)) return false;
    if (mock.questionCount === 0 || mock.runtimeQuestionReferences.length === 0) return false;
    return true;
}

function generateRuntimeMock(blueprint, title) {
    if (!blueprint) return null;
    let refs = prepareRuntimeQuestionList(blueprint);
    let stats = calculateRuntimeMockStatistics(refs);
    
    return {
        mockTitle: title || "Smart AI Mock",
        mockType: blueprint.mockType || "General",
        subject: blueprint.subject || "Mixed",
        topic: blueprint.topic || "Mixed",
        difficulty: blueprint.difficulty || "Mixed",
        questionCount: refs.length,
        estimatedDuration: blueprint.estimatedDuration || (refs.length * 60), // 60 sec per question
        estimatedMarks: refs.length, // 1 mark per question mapping
        estimatedDifficulty: blueprint.estimatedDifficulty || "Medium",
        runtimeQuestionReferences: refs,
        statistics: stats,
        status: refs.length > 0 ? "Ready" : "Empty"
    };
}

function generateRevisionMock(count, poolData, attemptHistory) {
    let bp = generateRevisionBlueprint(count, poolData, attemptHistory);
    // FAILSAFE: If no history exists or no revision available, fallback to original metadata/mixed
    if (!bp || bp.questionCount === 0) {
        let all = [];
        if (poolData && poolData.bySection) {
            Object.values(poolData.bySection).forEach(arr => { if (Array.isArray(arr)) all = all.concat(arr); });
        }
        bp = _buildBlueprintTemplate("Mixed Revision", "Mixed", "Mixed", "Mixed", count, all, { fallback: "Metadata Root" });
    }
    return generateRuntimeMock(bp, "Quick Revision Mock");
}

function generateSubjectMock(subject, count, poolData) {
    let bp = generateSubjectBlueprint(subject, count, poolData);
    // FAILSAFE: If subject unavailable, fallback to mixed revision
    if (!bp || bp.questionCount === 0) return generateRevisionMock(count, poolData, []);
    return generateRuntimeMock(bp, subject + " Mock");
}

function generateTopicMock(topic, count, poolData, fallbackSubject) {
    let bp = generateTopicBlueprint(topic, count, poolData);
    // FAILSAFE: If topic unavailable, fallback to subject
    if (!bp || bp.questionCount === 0) {
        if (fallbackSubject) return generateSubjectMock(fallbackSubject, count, poolData);
        return generateRevisionMock(count, poolData, []); // Cascading fallback
    }
    return generateRuntimeMock(bp, topic + " Practice Mock");
}

function generateDifficultyMock(difficulty, count, poolData) {
    let bp = generateDifficultyBlueprint(difficulty, count, poolData);
    if (!bp || bp.questionCount === 0) return generateRevisionMock(count, poolData, []);
    let diffTitle = difficulty.charAt(0).toUpperCase() + difficulty.slice(1);
