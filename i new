// 🔥 OFFLINE FIRST FETCH SYSTEM 🔥
async function fetchWithCache(refPath, cacheKey, expiryMinutes = 60) {
    let cachedStr = await getItemDB(cacheKey);
    let cacheTime = await getItemDB(cacheKey + '_time');
    let now = Date.now();
    
    if (!navigator.onLine && cachedStr) {
        return { 
            exists: () => true, 
            val: () => JSON.parse(cachedStr),
            forEach: function(cb) { 
                Object.entries(JSON.parse(cachedStr)).forEach(([k,v]) => cb({key:k, val:()=>v}));
            }
        };
    }
    
    if (navigator.onLine && cachedStr && cacheTime && (now - cacheTime < expiryMinutes * 60 * 1000)) {
        setTimeout(() => {
            if(!window.db) return;
            window.db.ref(refPath).once('value').then(async s => {
                if(s.exists()) {
                    await setItemDB(cacheKey, JSON.stringify(s.val()));
                    await setItemDB(cacheKey + '_time', Date.now());
                }
            }).catch(e => console.log("Background sync error"));
        }, 3000); 
        
        return { 
            exists: () => true, 
            val: () => JSON.parse(cachedStr),
            forEach: function(cb) { 
                Object.entries(JSON.parse(cachedStr)).forEach(([k,v]) => cb({key:k, val:()=>v}));
            }
        };
    } else if (navigator.onLine) {
        try {
            if(!window.db) throw new Error("DB not ready");
            const snap = await window.db.ref(refPath).once('value');
            if(snap.exists()) {
                await setItemDB(cacheKey, JSON.stringify(snap.val()));
                await setItemDB(cacheKey + '_time', Date.now());
            }
            return snap;
        } catch (err) {
            if (cachedStr) {
                return { 
                    exists: () => true, 
                    val: () => JSON.parse(cachedStr),
                    forEach: function(cb) { 
                        Object.entries(JSON.parse(cachedStr)).forEach(([k,v]) => cb({key:k, val:()=>v}));
                    }
                };
            }
            throw err;
        }
    } else {
         return { exists: () => false, val: () => null };
    }
}

