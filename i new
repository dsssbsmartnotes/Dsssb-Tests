async function openTestLeaderboard(testId, testTitle) {
    document.getElementById('rankModalTitle').innerText = "🏆 " + testTitle;
    document.getElementById('testRankModal').style.display = 'flex';
    document.getElementById('testRankBody').innerHTML = '<tr><td colspan="3" style="text-align:center; padding:20px;">Generating Ranks... ⏳</td></tr>';

    let myPermResultsStr = await getItemDB('dsssb_permanent_results_' + currentUserId);
    let myPermResults = myPermResultsStr ? JSON.parse(myPermResultsStr) : {};
    
    let myScoreObj = null;
    Object.values(myPermResults).forEach(r => {
        if (r.testId === testId) {
            if (!myScoreObj || parseFloat(r.score) > parseFloat(myScoreObj.score)) {
                myScoreObj = r; 
            }
        }
    });

    let testInfo = allTests.find(t => t.dbKey === testId) || {};
    let maxScore = parseInt(testInfo.qs) || parseInt(testInfo.marks) || 20;

    let ranks = [];
    const dummyNames = ["Rohan", "Priya", "Amit", "Neha", "Vikas", "Pooja", "Deepak", "Anjali", "Sanjay", "Sneha"];
    
    dummyNames.forEach((name, i) => {
        let fakeScore = maxScore - (i * (maxScore * 0.05)) - (Math.floor(Math.random() * 3));
        if (fakeScore < 0) fakeScore = 0;
        ranks.push({ name: name, score: parseFloat(fakeScore.toFixed(2)), isMe: false });
    });

    if (myScoreObj) {
        ranks.push({ name: currentUser, score: parseFloat(myScoreObj.score), isMe: true });
    }

    ranks.sort((a,b) => b.score - a.score);
    
    let myRankIndex = -1;
    let myData = null;
    
    ranks.forEach((r, index) => {
        if(r.isMe) {
            myRankIndex = index + 1; 
            myData = r;
        }
    });

    let html = "";
    let top5 = ranks.slice(0, 5); 
    let amIInTop5 = false;

    top5.forEach((r, i) => {
        let rankNum = i + 1;
        if(r.isMe) amIInTop5 = true;
        
        let badge = rankNum === 1 ? '<span style="font-size:18px;">🥇</span>' : 
                    rankNum === 2 ? '<span style="font-size:18px;">🥈</span>' : 
                    rankNum === 3 ? '<span style="font-size:18px;">🥉</span>' : 
                    `<div style="width:22px; height:22px; background:var(--border); border-radius:50%; display:grid; place-items:center; font-size:11px; margin:auto;">${rankNum}</div>`;
        
        let rowStyle = r.isMe ? 'background:var(--primary-light);' : '';
        let nameText = r.isMe ? `${r.name} <b style="color:var(--primary); font-size:10px;">(You)</b>` : r.name;
        
        html += `<tr style="${rowStyle}">
                    <td style="width: 50px; text-align:center;">${badge}</td>
                    <td style="font-weight:700;">${nameText}</td>
                    <td style="color:var(--primary); font-weight:900;">${r.score} Pts</td>
                </tr>`;
    });

    if (myData && !amIInTop5) {
        html += `<tr><td colspan="3" style="text-align:center; color:var(--text-muted); padding:8px; font-size:18px; letter-spacing:3px;">•••</td></tr>`;
        html += `<tr style="background:var(--primary-light); border-top:2px solid var(--primary);">
                    <td style="width: 50px; text-align:center; font-weight:900;">#${myRankIndex}</td>
                    <td style="font-weight:800;">${myData.name} <b style="color:var(--primary); font-size:10px;">(You)</b></td>
                    <td style="color:var(--primary); font-weight:900;">${myData.score} Pts</td>
                </tr>`;
    } 
    else if (!myData) {
        html += `<tr><td colspan="3" style="text-align:center; color:var(--text-muted); padding:8px; font-size:18px; letter-spacing:3px;">•••</td></tr>`;
        html += `<tr>
