}

async function loadWrongQuestions() {
    try {
        let mistakes = await loadMistakeNotebook();
        let wrongList = [];
        Object.keys(mistakes).forEach(k => {
            if (mistakes[k]) {
                wrongList.push(buildRuntimeQuestionReference(
                    mistakes[k].originalTestId || mistakes[k].testId || "unknown",
                    mistakes[k].originalIndex || mistakes[k].questionIndex || 0,
                    mistakes[k]
                ));
            }
        });
        return wrongList;
    } catch (e) {
        return [];
    }
}

function scanQuestionMetadata(q) {
    if (!q || typeof q !== 'object') return { section: "General", topic: "Mixed", difficulty: "Medium" };
    return {
        section: q.section || "General",
        topic: q.topic || "Mixed",
        difficulty: q.difficulty || "Medium"
    };
}

function buildRuntimeQuestionReference(testId, qIndex, q) {
    let meta = scanQuestionMetadata(q);
    return {
        testId: testId || "unknown",
        qIndex: Number(qIndex) || 0,
        section: meta.section,
        topic: meta.topic,
        difficulty: meta.difficulty
    };
}

function scanAvailableSubjects(allTestsArray) {
    let subjects = new Set();
    if (!Array.isArray(allTestsArray)) return [];
    allTestsArray.forEach(test => {
        if (test && Array.isArray(test.questions)) {
            test.questions.forEach(q => {
                let meta = scanQuestionMetadata(q);
                if (meta.section) subjects.add(meta.section);
            });
        }
    });
    return Array.from(subjects);
}

function scanAvailableTopics(allTestsArray) {
    let topics = new Set();
    if (!Array.isArray(allTestsArray)) return [];
    allTestsArray.forEach(test => {
        if (test && Array.isArray(test.questions)) {
            test.questions.forEach(q => {
                let meta = scanQuestionMetadata(q);
                if (meta.topic) topics.add(meta.topic);
            });
        }
    });
    return Array.from(topics);
}

function scanAvailableDifficulty(allTestsArray) {
    let difficulties = new Set();
    if (!Array.isArray(allTestsArray)) return [];
    allTestsArray.forEach(test => {
        if (test && Array.isArray(test.questions)) {
            test.questions.forEach(q => {
                let meta = scanQuestionMetadata(q);
                if (meta.difficulty) difficulties.add(meta.difficulty);
            });
        }
    });
    return Array.from(difficulties);
}

function analyzeAvailableQuestionPool(allTestsArray) {
    let pool = {
        totalQuestions: 0,
        bySection: {},
        byTopic: {},
        byDifficulty: {}
    };
    
    if (!Array.isArray(allTestsArray)) return pool;
    
    allTestsArray.forEach(test => {
        if (test && Array.isArray(test.questions)) {
            let tId = test.dbKey || test.id || "unknown";
            test.questions.forEach((q, idx) => {
                pool.totalQuestions++;
                let ref = buildRuntimeQuestionReference(tId, idx, q);
                
                if (!pool.bySection[ref.section]) pool.bySection[ref.section] = [];
                pool.bySection[ref.section].push(ref);
                
                if (!pool.byTopic[ref.topic]) pool.byTopic[ref.topic] = [];
                pool.byTopic[ref.topic].push(ref);
                
                if (!pool.byDifficulty[ref.difficulty]) pool.byDifficulty[ref.difficulty] = [];
                pool.byDifficulty[ref.difficulty].push(ref);
            });
        }
    });
    return pool;
}

function estimateMockAvailability(poolData) {
    let estimates = {
        possibleFullMocks: 0,
        possibleSectionalMocks: {},
        possibleTopicMocks: {}
    };
    
    if (!poolData || !poolData.bySection) return estimates;
    
    estimates.possibleFullMocks = Math.floor((poolData.totalQuestions || 0) / 100);
    
    Object.keys(poolData.bySection).forEach(sec => {
        let count = Array.isArray(poolData.bySection[sec]) ? poolData.bySection[sec].length : 0;
        estimates.possibleSectionalMocks[sec] = Math.floor(count / 20);
    });
    
    Object.keys(poolData.byTopic).forEach(top => {
        let count = Array.isArray(poolData.byTopic[top]) ? poolData.byTopic[top].length : 0;
        estimates.possibleTopicMocks[top] = Math.floor(count / 10);
    });
    
    return estimates;
}

function generateMockStatistics(poolData) {
    let stats = {
        totalSections: 0,
        totalTopics: 0,
        largestSection: null,
        largestTopic: null
    };
    
    if (!poolData) return stats;
    
    let maxSec = 0, maxTop = 0;
    
    if (poolData.bySection) {
        stats.totalSections = Object.keys(poolData.bySection).length;
        Object.keys(poolData.bySection).forEach(sec => {
            let len = poolData.bySection[sec].length;
            if (len > maxSec) { maxSec = len; stats.largestSection = sec; }
        });
    }
    
    if (poolData.byTopic) {
        stats.totalTopics = Object.keys(poolData.byTopic).length;
        Object.keys(poolData.byTopic).forEach(top => {
            let len = poolData.byTopic[top].length;
            if (len > maxTop) { maxTop = len; stats.largestTopic = top; }
        });
    }
    
    return stats;
}

async function createSmartMockEngine(userId, allTestsArray) {
    let cache = {
        timestamp: Date.now(),
        isReady: false,
        data: {}
    };

    try {
        let history = await loadAttemptHistory(userId);
        let wrongQs = await loadWrongQuestions();
        let savedQs = await loadSavedQuestions();
        
        let subjects = scanAvailableSubjects(allTestsArray);
        let topics = scanAvailableTopics(allTestsArray);
        let diffs = scanAvailableDifficulty(allTestsArray);
        
        let pool = analyzeAvailableQuestionPool(allTestsArray);
        let estimates = estimateMockAvailability(pool);
        let stats = generateMockStatistics(pool);
        
        cache.data = {
            userHistory: history,
            userMistakes: wrongQs,
            userSaved: savedQs,
            availableSubjects: subjects,
            availableTopics: topics,
            availableDifficulties: diffs,
            questionPool: pool,
            mockEstimates: estimates,
            poolStatistics: stats
        };
        cache.isReady = true;
    } catch (e) {
        cache.error = e.message;
    }
    
    return cache;
}
