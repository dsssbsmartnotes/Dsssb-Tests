function applyModernFilters() {
    const searchQuery = document.getElementById('testSearch').value.toLowerCase().trim();
    const categoryFilter = document.getElementById('examCategoryFilter').value.toLowerCase();
    const statusFilter = document.getElementById('examStatusFilter').value.toLowerCase();
    const sortFilter = document.getElementById('examSortFilter') ? document.getElementById('examSortFilter').value : 'default';

    let list = [...allTests].reverse().filter(t => t.dbKey !== 'auto_qod');

    if (searchQuery) {
        list = list.filter(t => 
            (t.title||"").toLowerCase().includes(searchQuery) || 
            (t.category||"").toLowerCase().includes(searchQuery) || 
            (t.tags||"").toLowerCase().includes(searchQuery)
        );
    }

    if (categoryFilter !== 'all') {
        list = list.filter(t => {
            const title = (t.title||"").toLowerCase();
            const cat = (t.category||"").toLowerCase();
            const tags = (t.tag||"").toLowerCase() + " " + (t.tags||"").toLowerCase();
            
            if(categoryFilter === 'full' || categoryFilter.includes('full')) return cat.includes('full') || title.includes('full') || tags.includes('full');
            if(categoryFilter === 'math') return title.includes('math') || cat.includes('math') || tags.includes('math') || title.includes('quant');
            if(categoryFilter === 'reasoning') return title.includes('reas') || cat.includes('reas') || tags.includes('reas') || title.includes('logic');
            if(categoryFilter === 'english') return title.includes('eng') || cat.includes('eng') || tags.includes('eng');
            if(categoryFilter === 'hindi') return title.includes('hin') || cat.includes('hin') || tags.includes('hin');
            if(categoryFilter === 'gk') return title.includes('gk') || cat.includes('gk') || tags.includes('gk') || title.includes('general');
            if(categoryFilter === 'computer') return title.includes('comp') || cat.includes('comp') || tags.includes('comp');
            
            return cat.includes(categoryFilter) || title.includes(categoryFilter) || tags.includes(categoryFilter);
        });
    }

    if (statusFilter !== 'all') {
        if (statusFilter === 'saved') {
            list = list.filter(t => SAVED_TESTS_CACHE.includes(t.dbKey));
        } else if (statusFilter === 'attempted') {
            list = list.filter(t => attemptedTestIds.has(t.dbKey) || attemptedTestIds.has(t.id));
        } else if (statusFilter === 'live') {
            list = list.filter(t => 
                (t.isLive && t.isLive.toString() === 'true') || 
                (t.scheduledTime && Date.now() >= t.scheduledTime) ||
                (t.category && t.category.toLowerCase().includes('live')) ||
                (t.tags && t.tags.toLowerCase().includes('live'))
            );
        }
    }

    if (sortFilter === 'date_desc') {
        list.sort((a, b) => {
            let valA = attemptedTestIds.get(a.dbKey) || attemptedTestIds.get(a.id);
            let valB = attemptedTestIds.get(b.dbKey) || attemptedTestIds.get(b.id);
            let timeA = valA ? valA.timestamp : 0;
            let timeB = valB ? valB.timestamp : 0;
            return timeB - timeA; 
        });
    } else if (sortFilter === 'date_asc') {
        list.sort((a, b) => {
            let valA = attemptedTestIds.get(a.dbKey) || attemptedTestIds.get(a.id);
            let valB = attemptedTestIds.get(b.dbKey) || attemptedTestIds.get(b.id);
            let timeA = valA ? valA.timestamp : 0;
            let timeB = valB ? valB.timestamp : 0;
            if(timeA === 0) return 1; 
            if(timeB === 0) return -1;
            return timeA - timeB; 
        });
    }

    renderTestCards(list);
}

