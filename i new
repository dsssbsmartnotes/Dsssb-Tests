function discoverLocalStorageData() {
    let lsData = {};
    try {
        for (let i = 0; i < localStorage.length; i++) {
            let key = localStorage.key(i);
            if (!key) continue;
            let val = localStorage.getItem(key);
            try {
                lsData[key] = (val && (val.startsWith('{') || val.startsWith('['))) ? JSON.parse(val) : val;
            } catch (e) {
                lsData[key] = val;
            }
        }
    } catch (e) {}
    return lsData;
}

async function discoverIndexedDBData() {
    let idbData = {};
    try {
        if (typeof initDB !== 'function') return idbData;
        const db = await initDB();
        const tx = db.transaction(IDB_STORE, 'readonly');
        const store = tx.objectStore(IDB_STORE);
        const keysReq = store.getAllKeys();
        const valsReq = store.getAll();
        
        const [keys, values] = await Promise.all([
            new Promise((res, rej) => { keysReq.onsuccess = () => res(keysReq.result); keysReq.onerror = () => rej(keysReq.error); }),
            new Promise((res, rej) => { valsReq.onsuccess = () => res(valsReq.result); valsReq.onerror = () => rej(valsReq.error); })
        ]);
        
        for (let i = 0; i < keys.length; i++) {
            try {
                idbData[keys[i]] = (typeof values[i] === 'string' && (values[i].startsWith('{') || values[i].startsWith('['))) ? JSON.parse(values[i]) : values[i];
            } catch(e) {
                idbData[keys[i]] = values[i];
            }
        }
    } catch (e) {}
    return idbData;
}

async function discoverApplicationData() {
    let lsData = discoverLocalStorageData();
    let idbData = await discoverIndexedDBData();
    return {
        localStorage: lsData,
        indexedDB: idbData,
        timestamp: Date.now()
    };
}

function analyzePreviousResults(discoveredData, userId) {
    let results = {};
    if (!discoveredData) return results;
    
    let tId = userId || (discoveredData.localStorage && discoveredData.localStorage['dsssb_user_id']) || "guest";
    let targetKey = 'dsssb_permanent_results_' + tId;
    
    if (discoveredData.indexedDB && discoveredData.indexedDB[targetKey]) {
        results = discoveredData.indexedDB[targetKey];
    } else if (discoveredData.localStorage && discoveredData.localStorage[targetKey]) {
        results = discoveredData.localStorage[targetKey];
    }
    
    if (Object.keys(results).length === 0) {
        let sources = [discoveredData.indexedDB, discoveredData.localStorage];
        sources.forEach(src => {
            if (!src) return;
            Object.keys(src).forEach(k => {
                if (k && k.startsWith('dsssb_permanent_results_')) {
                    Object.assign(results, src[k]);
                }
            });
        });
    }
    return results;
}

function analyzeAttemptHistory(discoveredData, userId) {
    let history = [];
    let results = analyzePreviousResults(discoveredData, userId);
    
    Object.values(results).forEach(r => {
        if (r && r.testId) {
            history.push({
                testId: r.testId,
                score: Number(r.score) || 0,
                correct: Number(r.correct) || 0,
                wrong: Number(r.wrong) || 0,
                skipped: Number(r.skipped) || 0,
                accuracy: Number(r.accuracy) || 0,
                timestamp: Number(r.timestamp || r.time) || 0
            });
        }
    });
    return history;
}

function analyzeMistakeNotebook(discoveredData) {
