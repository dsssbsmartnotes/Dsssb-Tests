        setSafeData('dsssb_last_backup_date', Date.now());
        showToast("Backup sent to Telegram successfully! 🚀", "success");
        
        document.getElementById('lastBackupText').innerText = `Last backed up: Just Now`;
        if (typeof checkBackupReminder === 'function') checkBackupReminder();

    } catch (err) {
        showToast("Telegram Send Failed: " + err.message, "error");
    } finally {
        btn.innerHTML = origText;
        btn.disabled = false;
    }
}

function renderBackupInfo(backupObj) {
    let box = document.getElementById('backupInfoBox');
    let sizeKB = (JSON.stringify(backupObj).length / 1024).toFixed(1);
    let dateStr = new Date(backupObj.metadata.timestamp).toLocaleString('en-IN');
    
    box.innerHTML = `
        <div style="margin-bottom:4px;"><b>App Ver:</b> v${backupObj.metadata.appVersion} | <b>Schema:</b> v${backupObj.metadata.schemaVersion || backupObj.metadata.version}</div>
        <div><b>File Size:</b> ${sizeKB} KB | <b>Records:</b> ${backupObj.metadata.idbRecords + backupObj.metadata.lsRecords}</div>
        <div style="margin-top:4px; font-size:9px;">Generated: ${dateStr}</div>
    `;
    box.style.display = 'block';
}

let pendingRestoreBackup = null;

async function processRestoreFile(event) {
    const file = event.target.files[0];
    if (!file) return;
    
    const btn = document.getElementById('restoreBackupBtn');
    const origText = btn.innerHTML;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Validating Integrity...';
    btn.disabled = true;
    
    const reader = new FileReader();
    reader.onload = async function(e) {
        try {
            let content = e.target.result;
            let backup = JSON.parse(content);
            
            // 1. Validation (Format)
            if (!backup.metadata || (!backup.metadata.version && !backup.metadata.schemaVersion) || !backup.idb || !backup.ls) {
                throw new Error("Invalid or unsupported backup format.");
            }
            
            // 2. Integrity Hash Check
            if (backup.integrityHash) {
                let providedHash = backup.integrityHash;
                let backupCopy = { ...backup };
                delete backupCopy.integrityHash;
                
                let rawJsonStr = JSON.stringify(backupCopy);
                const hashBuffer = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(rawJsonStr));
                const hashArray = Array.from(new Uint8Array(hashBuffer));
                const calculatedHash = hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
                
                if (providedHash !== calculatedHash) {
                    throw new Error("This backup appears to be corrupted or modified.");
                }
            } else if (backup.metadata.schemaVersion && parseFloat(backup.metadata.schemaVersion) >= 1.1) {
                 throw new Error("Corrupted Backup: Missing integrity hash.");
            }

            // 3. Version Compatibility Check
            let schemaVer = parseFloat(backup.metadata.schemaVersion || backup.metadata.version || "1.0");
            let appSchemaVer = 1.1; // Current Schema Version Phase 3.6.1
            
            let warnEl = document.getElementById('backupPreviewWarning');
            if (schemaVer > appSchemaVer) {
                throw new Error("This backup was created using a newer version of the application. Please update the app first.");
            } else if (schemaVer < appSchemaVer) {
                warnEl.style.display = 'block';
            } else {
                warnEl.style.display = 'none';
            }
            
            // Allow cross-user restore but warn (Strict Local First Logic)
            if (backup.metadata.userId !== currentUserId && currentUserId !== "guest") {
                 if(!confirm(`Warning: This backup was created by another account (ID: ${backup.metadata.userId}). Do you want to overwrite your progress with it?`)) {
                     throw new Error("Restore cancelled.");
                 }
            }

            // 4. Populate Preview Modal
            pendingRestoreBackup = backup;
            
            let dateStr = new Date(backup.metadata.timestamp).toLocaleDateString('en-IN', {day:'numeric', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit'});
            let sizeKB = (content.length / 1024).toFixed(1) + " KB";
            
            document.getElementById('prevDate').innerText = dateStr;
            document.getElementById('prevSize').innerText = sizeKB;
            document.getElementById('prevUser').innerText = backup.metadata.userId || "Unknown";
            document.getElementById('prevVer').innerText = `v${backup.metadata.appVersion || "1.0.0"}`;
            document.getElementById('prevSchema').innerText = `v${schemaVer}`;
            
            document.getElementById('prevXP').innerText = backup.ls['dsssb_user_xp'] || "0";
            document.getElementById('prevStreak').innerText = backup.ls['streak'] || "0";
            
            // Calculate Stats for Preview
            let testsCount = 0;
            for(let key in backup.idb) {
                if(key.startsWith('dsssb_permanent_results_')) {
                    try { testsCount += Object.keys(JSON.parse(backup.idb[key])).length; } catch(e){}
                }
            }
            let savedCount = 0;
            if(backup.idb['dsssb_bookmarks']) {
                try { savedCount = Object.keys(JSON.parse(backup.idb['dsssb_bookmarks'])).length; } catch(e){}
            }
            let mistakesCount = 0;
            if(backup.idb['dsssb_mistakes']) {
                try { mistakesCount = Object.keys(JSON.parse(backup.idb['dsssb_mistakes'])).length; } catch(e){}
            }
            
            document.getElementById('prevTests').innerText = testsCount;
            document.getElementById('prevSaved').innerText = savedCount;
            document.getElementById('prevMistakes').innerText = mistakesCount;

            document.getElementById('backupRestoreModal').style.display = 'none';
            document.getElementById('backupPreviewModal').style.display = 'flex';
            
        } catch(err) {
            if(err.message !== "Restore cancelled.") {
                showToast("Restore Error: " + err.message, "error");
            }
        } finally {
            document.getElementById('restoreFileInput').value = '';
            btn.innerHTML = '<i class="fas fa-file-import"></i> Select Backup File';
            btn.disabled = false;
        }
    };
    reader.readAsText(file);
}

async function createEmergencyBackup() {
    let lsData = {};
    const allowedLSKeys = ['dsssb_user_xp', 'streak', 'lastVisit', 'dsssb_base_xp', 'syllabusProgress', 'theme', 'my_target_name', 'my_target_date', 'dsssb_lucky_mock', 'rival_date', 'rival_name', 'rival_score'];
    allowedLSKeys.forEach(k => { let v = localStorage.getItem(k); if (v !== null) lsData[k] = v; });

    let idbData = {};
    const db = await initDB();
    const tx = db.transaction(IDB_STORE, 'readonly');
    const store = tx.objectStore(IDB_STORE);
    
    const keysReq = store.getAllKeys();
    const valsReq = store.getAll();
    const [keys, values] = await Promise.all([
        new Promise((res, rej) => { keysReq.onsuccess = () => res(keysReq.result); keysReq.onerror = () => rej(keysReq.error); }),
        new Promise((res, rej) => { valsReq.onsuccess = () => res(valsReq.result); valsReq.onerror = () => rej(valsReq.error); })
    ]);

    for (let i = 0; i < keys.length; i++) {
        let k = keys[i];
        if (k.startsWith('cache_') || k.startsWith('pro_') || k.startsWith('dsssb_inbox_') || k.endsWith('_time')) continue;
        if (k === 'dsssb_bookmarks' || k === 'dsssb_mistakes' || k === 'savedTests' || k.startsWith('dsssb_permanent_results_') || k === 'dsssb_unsynced_results' || k.startsWith('dsssb_cbt_rank_v2_')) {
            idbData[k] = values[i];
        }
    }
    await setItemDB('dsssb_emergency_backup', JSON.stringify({ idb: idbData, ls: lsData }));
}

async function executeRestore(mode) {
    if (!pendingRestoreBackup) return;
    let backup = pendingRestoreBackup;
    
    const btns = document.querySelectorAll('#backupPreviewModal .start-btn');
    btns.forEach(b => b.disabled = true);
    btns[0].innerHTML = '<i class="fas fa-spinner fa-spin"></i> Restoring Data...';

    try {
        // 1. Create Emergency Backup First
        await createEmergencyBackup();
        console.log("Emergency Backup Created successfully.");

        // 2. Restore LocalStorage
        for (let k in backup.ls) {
            if (k === 'dsssb_user_id' || k === 'dsssb_user_name' || k === 'dsssb_secure_session') continue;
            
            if (mode === 'merge' && localStorage.getItem(k) !== null) {
                if (k === 'dsssb_user_xp' || k === 'streak') {
                    let existingVal = parseInt(localStorage.getItem(k) || 0);
                    let backupVal = parseInt(backup.ls[k] || 0);
                    if (backupVal > existingVal) localStorage.setItem(k, backupVal);
                }
                continue; 
            }
            localStorage.setItem(k, backup.ls[k]);
        }

        // 3. Restore IndexedDB
        for (let k in backup.idb) {
            if (mode === 'replace') {
                await setItemDB(k, backup.idb[k]);
            } else if (mode === 'merge') {
                let existingStr = await getItemDB(k);
                if (!existingStr) {
                    await setItemDB(k, backup.idb[k]);
                } else {
                    if (k === 'dsssb_bookmarks' || k === 'dsssb_mistakes' || k.startsWith('dsssb_permanent_results_') || k === 'dsssb_unsynced_results') {
                        try {
                            let exObj = typeof existingStr === 'string' ? JSON.parse(existingStr) : existingStr;
                            let newObj = typeof backup.idb[k] === 'string' ? JSON.parse(backup.idb[k]) : backup.idb[k];
                            
                            if (Array.isArray(exObj) && Array.isArray(newObj)) {
                                let mergedArr = [...exObj];
                                newObj.forEach(newItem => {
                                    let exists = exObj.find(e => JSON.stringify(e) === JSON.stringify(newItem));
                                    if(!exists) mergedArr.push(newItem);
                                });
                                await setItemDB(k, JSON.stringify(mergedArr));
                            } else if (typeof exObj === 'object' && typeof newObj === 'object') {
                                let merged = { ...newObj, ...exObj }; 
                                await setItemDB(k, JSON.stringify(merged));
                            }
                        } catch(err) { console.error(`Smart Merge failed for ${k}`, err); }
                    } 
                    else if (k === 'savedTests') {
                        try {
                            let exArr = JSON.parse(existingStr);
                            let newArr = JSON.parse(backup.idb[k]);
                            let merged = [...new Set([...exArr, ...newArr])]; 
                            await setItemDB(k, JSON.stringify(merged));
                        } catch(err) {}
                    }
                }
            }
        }

        // 4. Success - Clear Emergency Backup
        await removeItemDB('dsssb_emergency_backup');
        
        showToast("Backup Restored Successfully! Reloading... 🚀", "success");
        setTimeout(() => { window.location.reload(); }, 1500);

    } catch(err) {
        // ROLLBACK
        console.error("Restore failed, rolling back...", err);
        try {
            let emDataStr = await getItemDB('dsssb_emergency_backup');
            if (emDataStr) {
                let emData = JSON.parse(emDataStr);
                for (let k in emData.ls) localStorage.setItem(k, emData.ls[k]);
                for (let k in emData.idb) await setItemDB(k, emData.idb[k]);
                showToast("Restore Failed. Previous Local Data Restored Successfully.", "error");
            } else {
                showToast("Restore Failed and Rollback unavailable.", "error");
            }
        } catch (rollbackErr) {
            showToast("Critical Error during rollback.", "error");
        } finally {
            let modal = document.getElementById('backupPreviewModal');
            if (modal) modal.style.display = 'none';
            
            if (typeof btns !== 'undefined' && btns.length > 0) {
                btns.forEach(b => b.disabled = false);
                btns[0].innerHTML = '<i class="fas fa-object-group"></i> Smart Merge Data';
            }
        }
    }
}
document.addEventListener('click', function goFullScreen() {
    if (/Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent)) {
        let doc = window.document;
        let docEl = doc.documentElement;
        // Added standard webkit lowercase 's' fallback and proper vendor prefixes
        let requestFullScreen = docEl.requestFullscreen || docEl.webkitRequestFullscreen || docEl.mozRequestFullScreen || docEl.webkitRequestFullScreen || docEl.msRequestFullscreen;
        let isFullScreen = doc.fullscreenElement || doc.webkitFullscreenElement || doc.mozFullScreenElement || doc.msFullscreenElement;
        
        if(requestFullScreen && !isFullScreen) {
            let fsPromise = requestFullScreen.call(docEl);
            // Safely check if a Promise was returned before attaching .catch()
            if (fsPromise !== undefined && fsPromise.catch) {
                fsPromise.catch(err => console.log("Fullscreen auto-trigger ignored by browser"));
            }
        }
    }
    document.removeEventListener('click', goFullScreen); 
});
  
