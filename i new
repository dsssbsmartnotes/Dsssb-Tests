        if(el.value === "ALL" && el.checked) {
            checkboxes.forEach(cb => { if(cb.value !== "ALL") cb.checked = false; });
        } else if (el.checked) {
            let allCb = document.querySelector('.top-chk[value="ALL"]');
            if(allCb) allCb.checked = false;
        }
        
        // Agar galti se saare uncheck ho gaye, toh "ALL" ko wapas check kar do
        if(Array.from(checkboxes).every(cb => !cb.checked)) {
            let allCb = document.querySelector('.top-chk[value="ALL"]');
            if(allCb) allCb.checked = true;
        }
    };
window.generateProTopicQuiz = async function() {
    if (!checkIsProMember()) {
        alert("👑 PREMIUM FEATURE LOCKED!\\n\\nUpgrade to PRO to unlock Unlimited Custom Quizzes.");
        return;
    }

   let selectedSubjects = Array.from(document.querySelectorAll('.sub-chk:checked')).map(cb => cb.value);
        let selectedTopics = Array.from(document.querySelectorAll('.top-chk:checked')).map(cb => cb.value);
        const questionLimit = parseInt(document.getElementById('proQuizCount').value);

        if(selectedSubjects.length === 0) selectedSubjects = ["ALL"];
        if(selectedTopics.length === 0) selectedTopics = ["ALL"];

        if (typeof allTests === 'undefined' || !Array.isArray(allTests) || allTests.length === 0) {
            alert("Tests load ho rahe hain... Kripya thoda wait karein!");
            return;
        }

        const btn = document.getElementById('proGenerateBtn');
        const origText = btn.innerHTML;
        btn.innerHTML = `<i class="fas fa-spinner fa-spin"></i> Merging Mocks...`;
        btn.disabled = true;

        try {
            let relevantTests = [];

            // 🚀 MERGE LOGIC: Force scan ONLY selected basket tests
            if (window.selectedMergeTests && window.selectedMergeTests.length > 0) {
                relevantTests = window.selectedMergeTests;
            } else {
                relevantTests = allTests;
                if (!selectedSubjects.includes("ALL")) {
                    relevantTests = allTests.filter(t => {
                        let searchStr = ((t.title||"") + " " + (t.category||"") + " " + (t.tags||"")).toLowerCase();
                        return selectedSubjects.some(s => searchStr.includes(s.toLowerCase())) || searchStr.includes('full');
                    });
                }
                relevantTests = relevantTests.slice(0, 15);
            }
        let fetchPromises = relevantTests.map(t => 
            fetch(`https://raw.githubusercontent.com/amit-cbt-admin/Dsssb-Tests/main/tests/${t.dbKey}.json`)
            .then(res => res.ok ? res.json() : null).catch(() => null)
        );

        let fetchedDataArray = await Promise.all(fetchPromises);
        let matchedQuestions = [];

        fetchedDataArray.forEach((testQs, index) => {
            let testMeta = relevantTests[index];
            if (testQs && Array.isArray(testQs)) {
                testQs.forEach((q, qIdx) => {
                    let qSubject = (q.section || "General").trim();
                    let qTopic = (q.topic || "").trim();

                    let subjectMatch = selectedSubjects.includes("ALL") || selectedSubjects.some(s => qSubject.toLowerCase() === s.toLowerCase());
                    let topicMatch = selectedTopics.includes("ALL") || selectedTopics.some(t => qTopic.toLowerCase() === t.toLowerCase());

                   if (subjectMatch && topicMatch) {
                        let cleanQ = Object.assign({}, q);
                        cleanQ.originalTestId = testMeta.dbKey;
                        cleanQ.originalIndex = qIdx;
                        
                        // 🚀 FIX: Original subject ko analytics ke liye hidden rakha
                        cleanQ.originalSection = qSubject; 
                        
                        // 🚀 FIX: Sabhi questions ko ek single Mega-Section mein daal diya
                        // Isse "Submit Section" ki boundary hat jayegi aur test direct chalega
                        cleanQ.section = "Custom Mock"; 
                        
                        cleanQ.topic = qTopic;
                        matchedQuestions.push(cleanQ);
                    }
                });
            }
        });

        if (matchedQuestions.length === 0) {
            alert(`No questions found for the selected Subjects & Topics.`);
            btn.innerHTML = origText;
            btn.disabled = false;
            return;
        }

        matchedQuestions.sort(() => Math.random() - 0.5);
        let finalQuestions = matchedQuestions.slice(0, questionLimit);
        
        let titleLabel = "Mix Mock";
        if (!selectedTopics.includes("ALL")) {
            titleLabel = selectedTopics[0] + (selectedTopics.length > 1 ? (" & " + (selectedTopics.length - 1) + " More") : "");
        } else if (!selectedSubjects.includes("ALL")) {
            titleLabel = selectedSubjects[0] + (selectedSubjects.length > 1 ? (" & " + (selectedSubjects.length - 1) + " More") : "");
        }

       const customMockPayload = {
            testId: "pro_custom_mock_" + Date.now(),
            title: `👑 CUSTOM MERGE: ${titleLabel}`,
            duration: finalQuestions.length * 1, 
            totalMarks: finalQuestions.length,
            positiveMarks: 1,
            negativeMarks: 0.25,
            questionCount: finalQuestions.length,
            questions: finalQuestions,
            languages: ["English", "Hindi"], // 🚀 FIX: Enabled Language Dropdown in CBT
            runtimeQuestionReferences: finalQuestions.map(q => q._key || q.id || Math.random().toString(36)) 
        };
        if (typeof setItemDB === 'function') {
            await setItemDB(customMockPayload.testId, JSON.stringify(customMockPayload));
        }
        localStorage.setItem('pyq_active_smart_mock', JSON.stringify(customMockPayload));
        window.location.href = `cbt.html?testId=${customMockPayload.testId}&mode=smart_mock`;

    } catch (e) {
        console.error("Merge Error:", e);
        alert("Network error! Data merge nahi ho paya.");
    } finally {
        btn.innerHTML = origText;
        btn.disabled = false;
    }
};

