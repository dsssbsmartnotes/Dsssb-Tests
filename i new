                        <i class="fas fa-lock" style="margin-right:5px;"></i> Aapne test nahi diya hai. Start Mock Test par click karein!
                    </td>
                </tr>`;
    }
    
    document.getElementById('testRankBody').innerHTML = html;
}

async function fetchDynamicFolders() {
    try {
        let cachedStr = await getItemDB('cache_folders_github');
        let cacheTime = await getItemDB('cache_folders_github_time');
        let now = Date.now();
        
        if (cachedStr && cacheTime && (now - cacheTime < 60 * 60 * 1000)) {
            dynamicFolders = JSON.parse(cachedStr);
            renderDynamicFolders();
            
            if (navigator.onLine && GITHUB_FOLDERS_URL !== "") {
                fetch(GITHUB_FOLDERS_URL).then(res => res.json()).then(data => {
                    setItemDB('cache_folders_github', JSON.stringify(data));
                    setItemDB('cache_folders_github_time', Date.now());
                }).catch(e => console.log("Background folder sync failed"));
            }
            return;
        }

        if (navigator.onLine && GITHUB_FOLDERS_URL !== "") {
            const response = await fetch(GITHUB_FOLDERS_URL);
            if (!response.ok) throw new Error("Network response was not ok");
            const data = await response.json();
            
            dynamicFolders = data;
            renderDynamicFolders();
            
            await setItemDB('cache_folders_github', JSON.stringify(data));
            await setItemDB('cache_folders_github_time', Date.now());
        } 
        else if (cachedStr) {
            dynamicFolders = JSON.parse(cachedStr);
            renderDynamicFolders();
        } else {
            console.log("No dynamic folders found.");
            document.getElementById('dynamicTreeContainer').innerHTML = `<div style="text-align:center; padding: 20px; color:var(--text-muted); width: 100%;">No Folders Found</div>`;
        }
    } catch(e) {
        console.error("Error fetching folders from GitHub:", e);
        let cachedStr = await getItemDB('cache_folders_github');
        if(cachedStr) {
            dynamicFolders = JSON.parse(cachedStr);
            renderDynamicFolders();
        } else {
            document.getElementById('dynamicTreeContainer').innerHTML = `<div style="text-align:center; padding: 20px; color:var(--text-muted); width: 100%;">Setup your GitHub Folders URL</div>`;
        }
    }
}

