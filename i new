function groupQuestionsBySection(questionList) {
    let groups = {};
    if (!Array.isArray(questionList)) return groups;
    
    questionList.forEach(q => {
        if (!q) return;
        let sec = q.section || "General";
        if (!groups[sec]) groups[sec] = [];
        groups[sec].push(q);
    });
    return groups;
}

function groupQuestionsByTopic(questionList) {
    let groups = {};
    if (!Array.isArray(questionList)) return groups;
    
    questionList.forEach(q => {
        if (!q) return;
        let topic = q.topic || "Mixed";
        if (!groups[topic]) groups[topic] = [];
        groups[topic].push(q);
    });
    return groups;
}

function groupQuestionsByDifficulty(questionList) {
    let groups = {};
    if (!Array.isArray(questionList)) return groups;
    
    questionList.forEach(q => {
        if (!q) return;
        let diff = q.difficulty || "Medium";
        if (!groups[diff]) groups[diff] = [];
        groups[diff].push(q);
    });
    return groups;
}

function calculateQuestionAvailability(questionList, attemptHistory) {
    let available = [];
    let attempted = [];
    let attemptedSet = new Set();
    
    if (Array.isArray(attemptHistory)) {
        attemptHistory.forEach(h => {
            if (h && h.testId) attemptedSet.add(h.testId);
        });
    }
    
    if (Array.isArray(questionList)) {
        questionList.forEach(q => {
            if (q && attemptedSet.has(q.testId)) {
                attempted.push(q);
            } else if (q) {
                available.push(q);
            }
        });
    }
    return { available, attempted };
}

function calculateSectionStatistics(sectionGroups, attemptHistory, wrongList, savedList) {
    let stats = {};
    if (!sectionGroups) return stats;
    
    Object.keys(sectionGroups).forEach(sec => {
        let qs = sectionGroups[sec] || [];
        let avail = calculateQuestionAvailability(qs, attemptHistory);
        
        let wCount = Array.isArray(wrongList) ? wrongList.filter(w => w && w.section === sec).length : 0;
        let sCount = Array.isArray(savedList) ? savedList.filter(s => s && s.section === sec).length : 0;
        
        stats[sec] = {
            sectionName: sec,
            totalQuestions: qs.length,
            attempted: avail.attempted.length,
            correct: Math.max(0, avail.attempted.length - wCount),
            wrong: wCount,
            saved: sCount,
            available: avail.available.length
        };
    });
    return stats;
}

function calculateTopicStatistics(topicGroups, attemptHistory, wrongList, savedList) {
    let stats = {};
    if (!topicGroups) return stats;
    
    Object.keys(topicGroups).forEach(top => {
        let qs = topicGroups[top] || [];
        let avail = calculateQuestionAvailability(qs, attemptHistory);
        
        let wCount = Array.isArray(wrongList) ? wrongList.filter(w => w && w.topic === top).length : 0;
        let sCount = Array.isArray(savedList) ? savedList.filter(s => s && s.topic === top).length : 0;
        
        let totalAtt = avail.attempted.length;
        let acc = totalAtt > 0 ? Math.round(((totalAtt - wCount) / totalAtt) * 100) : 0;
        
        stats[top] = {
            topicName: top,
            totalQuestions: qs.length,
            attempted: totalAtt,
            correct: Math.max(0, totalAtt - wCount),
            wrong: wCount,
            saved: sCount,
            accuracy: Math.max(0, Math.min(100, acc)),
            available: avail.available.length
        };
    });
    return stats;
}

function calculateDifficultyStatistics(difficultyGroups) {
    let stats = { easy: 0, medium: 0, hard: 0 };
    if (!difficultyGroups) return stats;
    
    Object.keys(difficultyGroups).forEach(diff => {
        let count = Array.isArray(difficultyGroups[diff]) ? difficultyGroups[diff].length : 0;
        let dLow = String(diff).toLowerCase();
        
        if (dLow.includes('easy')) stats.easy += count;
        else if (dLow.includes('hard')) stats.hard += count;
        else stats.medium += count;
    });
    return stats;
}

function generateQuestionPoolSummary(allQuestions, attemptHistory, wrongList, savedList, mistakeNotebook) {
    let sections = groupQuestionsBySection(allQuestions);
    let topics = groupQuestionsByTopic(allQuestions);
    let diffs = groupQuestionsByDifficulty(allQuestions);
    
    let wCount = Array.isArray(wrongList) ? wrongList.length : 0;
    let sCount = Array.isArray(savedList) ? savedList.length : 0;
    let mCount = mistakeNotebook ? Object.keys(mistakeNotebook).length : 0;
    
    return {
        totalQuestions: Array.isArray(allQuestions) ? allQuestions.length : 0,
        subjects: Object.keys(sections).length,
        topics: Object.keys(topics).length,
        difficulties: calculateDifficultyStatistics(diffs),
        wrongQuestions: wCount,
        savedQuestions: sCount,
        mistakeQuestions: mCount
    };
}
