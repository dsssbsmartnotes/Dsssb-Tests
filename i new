function _shuffleAndSliceData(arr, count) {
    if (!Array.isArray(arr)) return [];
    let copy = arr.slice();
    for (let i = copy.length - 1; i > 0; i--) {
        let j = Math.floor(Math.random() * (i + 1));
        let temp = copy[i];
        copy[i] = copy[j];
        copy[j] = temp;
    }
    return copy.slice(0, Math.max(0, count || 10));
}

function calculateBlueprintStatistics(runtimeReferences) {
    let stats = { estimatedDuration: 0, estimatedDifficulty: "Medium", hardCount: 0, easyCount: 0, mediumCount: 0, validRefs: 0 };
    if (!Array.isArray(runtimeReferences)) return stats;
    
    runtimeReferences.forEach(r => {
        if (!r) return;
        stats.validRefs++;
        let d = String(r.difficulty || "").toLowerCase();
        if (d.includes('hard')) stats.hardCount++;
        else if (d.includes('easy')) stats.easyCount++;
        else stats.mediumCount++;
    });
    
    stats.estimatedDuration = stats.validRefs * 60; // Base: 60 seconds per question
    
    if (stats.validRefs > 0) {
        if (stats.hardCount >= stats.validRefs * 0.4) stats.estimatedDifficulty = "Hard";
        else if (stats.easyCount >= stats.validRefs * 0.5) stats.estimatedDifficulty = "Easy";
    }
    return stats;
}

function _buildBlueprintTemplate(type, subject, topic, difficulty, reqCount, poolArray, metadata) {
    let safePool = Array.isArray(poolArray) ? poolArray : [];
    let refs = _shuffleAndSliceData(safePool, reqCount);
    let stats = calculateBlueprintStatistics(refs);
    
    return {
        mockType: type || "General",
        subject: subject || "Mixed",
        topic: topic || "Mixed",
        difficulty: difficulty || "Mixed",
        questionCount: refs.length,
        availableQuestions: safePool.length,
        runtimeReferences: refs, // Only runtime references, no duplicates
        estimatedDuration: stats.estimatedDuration,
        estimatedDifficulty: stats.estimatedDifficulty,
        metadata: metadata || {}
    };
}

function validateBlueprint(blueprint) {
    if (!blueprint) return false;
    if (!Array.isArray(blueprint.runtimeReferences)) return false;
    if (blueprint.questionCount !== blueprint.runtimeReferences.length) return false;
    if (blueprint.questionCount === 0) return false;
    return true;
}

function generateSubjectBlueprint(subject, count, poolData) {
    let qs = (poolData && poolData.bySection && poolData.bySection[subject]) ? poolData.bySection[subject] : [];
    return _buildBlueprintTemplate("Subject Mock", subject, "Mixed", "Mixed", count, qs, { target: subject });
}

function generateTopicBlueprint(topic, count, poolData) {
    let qs = (poolData && poolData.byTopic && poolData.byTopic[topic]) ? poolData.byTopic[topic] : [];
    return _buildBlueprintTemplate("Topic Mock", "Mixed", topic, "Mixed", count, qs, { target: topic });
}

function generateDifficultyBlueprint(difficulty, count, poolData) {
    let qs = (poolData && poolData.byDifficulty && poolData.byDifficulty[difficulty]) ? poolData.byDifficulty[difficulty] : [];
    return _buildBlueprintTemplate("Difficulty Mock", "Mixed", "Mixed", difficulty, count, qs, { target: difficulty });
}

function generateWrongQuestionBlueprint(count, wrongList) {
    return _buildBlueprintTemplate("Mistake Revision", "Mixed", "Mixed", "Mixed", count, wrongList, { source: "Wrong Questions" });
}

function generateSavedQuestionBlueprint(count, savedList) {
    return _buildBlueprintTemplate("Saved Revision", "Mixed", "Mixed", "Mixed", count, savedList, { source: "Saved Questions" });
}

function generateMistakeBlueprint(count, mistakeNotebook) {
    let qs = [];
    if (mistakeNotebook && typeof mistakeNotebook === 'object') {
        Object.keys(mistakeNotebook).forEach(k => {
            if (mistakeNotebook[k]) {
                let m = mistakeNotebook[k];
                qs.push({
                    testId: m.originalTestId || m.testId || "unknown",
                    qIndex: Number(m.originalIndex || m.questionIndex) || 0,
                    section: m.section || "General",
                    topic: m.topic || "Mixed",
                    difficulty: m.difficulty || "Medium"
                });
            }
        });
    }
    return _buildBlueprintTemplate("Notebook Practice", "Mixed", "Mixed", "Mixed", count, qs, { source: "Mistake Notebook" });
}

function generateWeakSubjectBlueprint(count, poolData, sectionStats) {
    let weakSub = "Mixed";
    let lowestAcc = 101;
    
    if (sectionStats) {
        Object.keys(sectionStats).forEach(sec => {
            let stat = sectionStats[sec];
            let acc = stat.attempted > 0 ? (stat.correct / stat.attempted) * 100 : 100;
            if (stat.attempted >= 5 && acc < lowestAcc) { // Minimum threshold for accuracy logic
                lowestAcc = acc;
                weakSub = sec;
            }
        });
    }
    
    let qs = (poolData && poolData.bySection && poolData.bySection[weakSub]) ? poolData.bySection[weakSub] : [];
    return _buildBlueprintTemplate("Weak Subject Challenge", weakSub, "Mixed", "Mixed", count, qs, { accuracy: lowestAcc });
}

function generateWeakTopicBlueprint(count, poolData, topicStats) {
    let weakTop = "Mixed";
    let lowestAcc = 101;
    
    if (topicStats) {
        Object.keys(topicStats).forEach(top => {
            let stat = topicStats[top];
            let acc = stat.attempted > 0 ? (stat.correct / stat.attempted) * 100 : 100;
            if (stat.attempted >= 3 && acc < lowestAcc) {
                lowestAcc = acc;
                weakTop = top;
            }
        });
    }
    
    let qs = (poolData && poolData.byTopic && poolData.byTopic[weakTop]) ? poolData.byTopic[weakTop] : [];
    return _buildBlueprintTemplate("Weak Topic Challenge", "Mixed", weakTop, "Mixed", count, qs, { accuracy: lowestAcc });
}

function generateRevisionBlueprint(count, poolData, attemptHistory) {
    let qs = [];
    let attemptedSet = new Set();
    
    if (Array.isArray(attemptHistory)) {
        attemptHistory.forEach(h => { if (h && h.testId) attemptedSet.add(h.testId); });
    }
    
    if (poolData && poolData.bySection) {
        Object.values(poolData.bySection).forEach(secQs => {
            if (Array.isArray(secQs)) {
                secQs.forEach(q => {
                    if (q && attemptedSet.has(q.testId)) qs.push(q);
                });
            }
        });
    }
    return _buildBlueprintTemplate("Fast Revision", "Mixed", "Mixed", "Mixed", count, qs, { source: "Attempted Set" });
}

function generateConfidenceBlueprint(count, poolData) {
    let eQs = [];
    if (poolData && poolData.byDifficulty) {
        Object.keys(poolData.byDifficulty).forEach(k => {
            if (String(k).toLowerCase().includes('easy')) {
                eQs = eQs.concat(poolData.byDifficulty[k]);
            }
        });
    }
    return _buildBlueprintTemplate("Confidence Booster", "Mixed", "Mixed", "Easy", count, eQs, { intent: "Motivation" });
}

function generateChallengeBlueprint(count, poolData) {
    let hQs = [];
    if (poolData && poolData.byDifficulty) {
        Object.keys(poolData.byDifficulty).forEach(k => {
            if (String(k).toLowerCase().includes('hard')) {
                hQs = hQs.concat(poolData.byDifficulty[k]);
            }
        });
    }
    return _buildBlueprintTemplate("Challenge Mock", "Mixed", "Mixed", "Hard", count, hQs, { intent: "Stress Test" });
}

function generateAdaptiveBlueprint(count, poolData, wrongList, savedList, sectionStats) {
    let target = count || 20;
    let wQs = _shuffleAndSliceData(wrongList || [], Math.floor(target * 0.3)); // 30% mistakes
    let sQs = _shuffleAndSliceData(savedList || [], Math.floor(target * 0.2)); // 20% saved
    
    // Fill remaining with random pool
    let genQs = [];
    if (poolData && poolData.bySection) {
        let all = [];
        Object.values(poolData.bySection).forEach(arr => { if(Array.isArray(arr)) all = all.concat(arr); });
        genQs = _shuffleAndSliceData(all, target - wQs.length - sQs.length);
    }
    
    let combined = [].concat(wQs, sQs, genQs);
    let finalQs = _shuffleAndSliceData(combined, target); // Final shuffle
    
    let blueprint = _buildBlueprintTemplate("Adaptive Mock", "Mixed", "Mixed", "Mixed", target, finalQs, { algorithm: "Priority Mix" });
    blueprint.availableQuestions = combined.length; // Override template calculation to reflect combined pool size
    return blueprint;
}
