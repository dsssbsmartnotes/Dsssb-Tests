    async function resolveSmartRefs(dataObj) {
        let neededTests = {};
        for (let k in dataObj) {
            if (dataObj[k] && dataObj[k].isSmartRef) {
                let tId = dataObj[k].testId;
                if (!neededTests[tId]) neededTests[tId] = [];
                neededTests[tId].push(k);
            }
        }
        for (let tId in neededTests) {
            try {
                let res = await fetch(`https://raw.githubusercontent.com/amit-cbt-admin/Dsssb-Tests/main/tests/${tId}.json`);
                let qs = await res.json();
                neededTests[tId].forEach(k => {
                    let ref = dataObj[k];
                    if (qs[ref.questionIndex]) {
                        let loadedQ = Object.assign({}, qs[ref.questionIndex]);
                        // 🔥 Language Preservation Magic 🔥
                        if (ref.language === 'en') {
                            loadedQ.q_hi = loadedQ.q_en;
                            loadedQ.op_hi = loadedQ.op_en;
                        } else if (ref.language === 'hi') {
                            loadedQ.q_en = loadedQ.q_hi;
                            loadedQ.op_en = loadedQ.op_hi;
                        }
                        dataObj[k] = Object.assign({}, loadedQ, {
                            forceLanguage: ref.language,
                            isSmartRef: true,
                            originalTestId: tId,
                            originalIndex: ref.questionIndex,
                            savedAt: ref.savedAt,
                            section: ref.section || loadedQ.section || "General",
                            topic: ref.topic || loadedQ.topic || "",
                            _key: k
                        });
                    }
                });
            } catch(e) { console.log("Failed to load test JSON:", tId); }
        }
        return dataObj;
    }

