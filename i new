<script>
/* =======================================================
   🔥 PHASE 3.5: COMMUNICATION CENTER ENGINE 🔥
   ======================================================= */

let cachedInboxMessages = [];

async function syncInboxEngine() {
    // Firebase Inbox Sync disabled. Using 100% Offline Fast Storage.
    let safeMyId = String(currentUserId).trim().replace(/[^a-zA-Z0-9_]/g, '_');
    await loadInboxFromCache();
    checkLocalMembershipWarnings(safeMyId);
}

async function loadInboxFromCache() {
    let safeMyId = String(currentUserId).trim().replace(/[^a-zA-Z0-9_]/g, '_');
    let localDataStr = await getItemDB('dsssb_inbox_' + safeMyId);
    if (localDataStr) {
        cachedInboxMessages = JSON.parse(localDataStr);
        updateInboxBadgeUI();
    }
}

function updateInboxBadgeUI() {
    let unreadCount = cachedInboxMessages.filter(m => m.status === 'unread' || !m.status).length;
    let badge = document.getElementById('inboxBadge');
    if (badge) {
        if (unreadCount > 0) {
            badge.innerText = unreadCount > 99 ? '99+' : unreadCount;
            badge.style.display = 'block';
        } else {
            badge.style.display = 'none';
        }
    }
}

function openInbox() {
    // Deselect other tabs
    document.querySelectorAll('.tab-content').forEach(t => t.style.display = 'none');
    document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
    
    document.getElementById('tab-inbox').style.display = 'block';
    window.scrollTo({ top: 0, behavior: 'smooth' });
    
    renderInbox();
}

function renderInbox() {
    const container = document.getElementById('inboxListContainer');
    const emptyState = document.getElementById('inboxEmptyState');
    const searchTerm = (document.getElementById('inboxSearch').value || "").toLowerCase().trim();

    let displayList = cachedInboxMessages.filter(m => m.status !== 'deleted');

    if (searchTerm) {
        displayList = displayList.filter(m => 
            (m.title && m.title.toLowerCase().includes(searchTerm)) || 
            (m.message && m.message.toLowerCase().includes(searchTerm)) ||
            (m.category && m.category.toLowerCase().includes(searchTerm))
        );
    }

    if (displayList.length === 0) {
        container.innerHTML = "";
        emptyState.style.display = 'block';
        if (searchTerm) emptyState.querySelector('h3').innerText = "No Results Found";
        else emptyState.querySelector('h3').innerText = "All Caught Up!";
        return;
    }

    emptyState.style.display = 'none';
    let html = "";
    let lastDate = "";

    displayList.forEach(msg => {
        let dateObj = new Date(msg.timestamp);
        let dateStr = dateObj.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
        
        // Grouping by Date UI
        if (dateStr !== lastDate) {
            html += `<div style="font-size:11px; font-weight:800; color:var(--text-muted); text-transform:uppercase; margin: 20px 0 10px 5px; letter-spacing:0.5px;"><i class="far fa-calendar-alt"></i> ${dateStr}</div>`;
            lastDate = dateStr;
        }

        let isUnread = (msg.status === 'unread' || !msg.status);
        let timeStr = dateObj.toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' });
        
        // Determine Icons & Colors
        let catIcon = "fas fa-info-circle";
        let catClass = "";
        let safeCat = (msg.category || "System").toLowerCase();
        
        if (safeCat.includes("payment") || safeCat.includes("pro")) { catIcon = "fas fa-check-circle"; catClass = "cat-payment"; }
        else if (safeCat.includes("admin") || safeCat.includes("support")) { catIcon = "fas fa-headset"; catClass = "cat-admin"; }
        else if (safeCat.includes("system") || safeCat.includes("warning")) { catIcon = "fas fa-exclamation-triangle"; catClass = "cat-system"; }

        html += `
        <div class="inbox-card ${isUnread ? 'unread' : ''}" id="msg_${msg.id}" onclick="toggleMessage('${msg.id}')">
            <div class="inbox-title">
                <span>${msg.title}</span>
                <span class="inbox-time">${timeStr}</span>
            </div>
            <div class="inbox-footer">
                <span class="inbox-cat ${catClass}"><i class="${catIcon}"></i> ${msg.category || "Update"}</span>
            </div>
            <div class="inbox-body">${msg.message}</div>
            <div style="text-align:right; margin-top:5px;">
                <button class="msg-del-btn" onclick="softDeleteMessage('${msg.id}', event)"><i class="fas fa-trash-alt"></i> Delete</button>
            </div>
        </div>`;
    });

    container.innerHTML = html;
}

function toggleMessage(msgId) {
    let el = document.getElementById('msg_' + msgId);
    let isOpen = el.classList.contains('open');
    
    // Close others optionally, or leave open. We'll let them open multiple.
    if (!isOpen) {
        el.classList.add('open');
        // Mark Read
        let msgIndex = cachedInboxMessages.findIndex(m => m.id === msgId);
        if (msgIndex > -1 && (!cachedInboxMessages[msgIndex].status || cachedInboxMessages[msgIndex].status === 'unread')) {
            cachedInboxMessages[msgIndex].status = 'read';
            el.classList.remove('unread');
            updateInboxBadgeUI();
            persistMessageStatus(msgId, 'read');
        }
    } else {
        el.classList.remove('open');
    }
}

async function markAllInboxRead() {
    let changed = false;
    cachedInboxMessages.forEach(m => {
        if (m.status !== 'deleted' && m.status !== 'read') {
            m.status = 'read';
            changed = true;
            persistMessageStatus(m.id, 'read');
        }
    });
    
    if (changed) {
        let safeMyId = String(currentUserId).trim().replace(/[^a-zA-Z0-9_]/g, '_');
        await setItemDB('dsssb_inbox_' + safeMyId, JSON.stringify(cachedInboxMessages));
        updateInboxBadgeUI();
        renderInbox();
        showToast("All messages marked as read ✅");
    }
}

async function softDeleteMessage(msgId, event) {
    event.stopPropagation();
    let msgIndex = cachedInboxMessages.findIndex(m => m.id === msgId);
    if (msgIndex > -1) {
        cachedInboxMessages[msgIndex].status = 'deleted';
        let safeMyId = String(currentUserId).trim().replace(/[^a-zA-Z0-9_]/g, '_');
        await setItemDB('dsssb_inbox_' + safeMyId, JSON.stringify(cachedInboxMessages));
        persistMessageStatus(msgId, 'deleted');
        
        let el = document.getElementById('msg_' + msgId);
        el.style.opacity = '0';
        el.style.transform = 'translateX(50px)';
        setTimeout(() => { renderInbox(); updateInboxBadgeUI(); }, 300);
        showToast("Message deleted");
    }
}

function persistMessageStatus(msgId, newStatus) {
    // Firebase message status tracking disabled for offline mode.
    console.log("Message status saved locally.");
}
// System Function for Local Automated Warnings (Phase 3.5 Req)
async function checkLocalMembershipWarnings(safeUserId) {
    if (!isPro) return;
    let localMemStr = await getItemDB('pro_membership_cache_' + safeUserId);
    if (localMemStr) {
        let mem = JSON.parse(localMemStr);
        if (mem.daysRemaining !== 'Lifetime' && typeof mem.daysRemaining === 'number') {
            let warnLevel = "";
            if (mem.daysRemaining === 7) warnLevel = "7_days";
            else if (mem.daysRemaining === 3) warnLevel = "3_days";
            else if (mem.daysRemaining === 1) warnLevel = "1_day";
            
            if (warnLevel) {
                let warnId = `auto_warn_${warnLevel}_${mem.expiryDate}`;
                // Check if already injected locally to prevent duplicates
                if (!cachedInboxMessages.find(m => m.id === warnId)) {
                    let newMsg = {
                        id: warnId,
                        title: "⚠️ Subscription Expiring Soon",
                        message: `Your PRO membership will expire in ${mem.daysRemaining} day(s). Renew now to maintain uninterrupted access to premium mocks and PDF notes.`,
                        category: "Membership",
                        timestamp: Date.now(),
                        status: "unread"
                    };
                    cachedInboxMessages.unshift(newMsg); // Add to top
                    await setItemDB('dsssb_inbox_' + safeUserId, JSON.stringify(cachedInboxMessages));
                    updateInboxBadgeUI();
                    
                    // Local System notification only
                    console.log("Auto warning generated locally.");
                }
            }
       }
    }
}
</script>
<script>
    window.SmartMockEngine = (function() {
        let state = {
            engineReady: false,
            questionPool: [],
            attemptHistory: [],
            wrongQuestionPool: [],
            savedQuestionPool: [],
            metadataCache: {},
            subjectIndex: {},
            topicIndex: {},
            difficultyIndex: {},
            statistics: {}
        };

        // Public API
        return {
                init: function(config = {}) {
                    if (config.questions) state.questionPool = config.questions;
                    if (config.attemptHistory) state.attemptHistory = config.attemptHistory;
                    if (config.wrongQuestions) state.wrongQuestionPool = config.wrongQuestions;
                    if (config.savedQuestions) state.savedQuestionPool = config.savedQuestions;
                    
                    if (state.engineReady) return state;
                console.log("SmartMockEngine: init() called. Foundation Ready.");
                state.engineReady = true;
                return true;
            },
            scan: async function() {
                if (!state.engineReady) return false;
                try {
                    await this.scanAttemptHistory();
                    await this.scanMistakeNotebook();
                    await this.scanSavedQuestions();
                    this.scanQuestionPool();
                    this.scanMetadata();
                    this.indexSubjects();
                    this.indexTopics();
                    this.indexDifficulty();
                    
                    state.statistics = this.getScanSummary();
                    return true;
                } catch(e) {
                    console.error("SmartMockEngine Scan Error (Safely Ignored):", e);
                    return false;
                }
            },
            scanQuestionPool: function() {
                state.questionPool = typeof window.QUESTIONS !== 'undefined' && Array.isArray(window.QUESTIONS) ? window.QUESTIONS : [];
                return state.questionPool.length;
            },
            scanAttemptHistory: async function() {
                let uId = typeof window.currentUserId !== 'undefined' ? window.currentUserId : 'guest';
                if (typeof window.getItemDB === 'function') {
                    let res = await window.getItemDB('dsssb_permanent_results_' + uId);
                    state.attemptHistory = res ? Object.values(JSON.parse(res)) : [];
                }
                return state.attemptHistory.length;
            },
            scanWrongQuestions: async function() {
                if (typeof window.getItemDB === 'function') {
                    let mkStr = await window.getItemDB('dsssb_mistakes');
                    let mkObj = mkStr ? JSON.parse(mkStr) : {};
                    state.wrongQuestionPool = Object.values(mkObj);
                }
                return state.wrongQuestionPool.length;
            },
            scanSavedQuestions: async function() {
                if (typeof window.getItemDB === 'function') {
                    let bmStr = await window.getItemDB('dsssb_bookmarks');
                    let bmObj = bmStr ? JSON.parse(bmStr) : {};
                    state.savedQuestionPool = Object.values(bmObj);
                }
                return state.savedQuestionPool.length;
            },
            scanMistakeNotebook: async function() {
                return await this.scanWrongQuestions();
            },
            scanMetadata: function() {
                state.metadataCache = {};
                let combined = [...state.questionPool, ...state.wrongQuestionPool, ...state.savedQuestionPool];
                
                for (let i = 0; i < combined.length; i++) {
                    let q = combined[i];
                    if (!q) continue; // Null Safe
                    
                    let key = q._key || q.id || ('auto_'+i);
                    if (!state.metadataCache[key]) {
                        state.metadataCache[key] = {
                            section: q.section || q.subject || "General", // Missing Section Safe
                            topic: q.topic || "Uncategorized", // Missing Topic Safe
                            difficulty: q.difficulty || "Medium", // Missing Difficulty Safe
                            qNum: q.originalIndex || q.qNum || (i + 1)
                        };
                    }
                }
                return Object.keys(state.metadataCache).length;
            },
            indexSubjects: function() {
                state.subjectIndex = {};
                for (let key in state.metadataCache) {
                    let sec = state.metadataCache[key].section;
                    if (!state.subjectIndex[sec]) state.subjectIndex[sec] = [];
                    state.subjectIndex[sec].push(key);
                }
                return Object.keys(state.subjectIndex).length;
            },
            indexTopics: function() {
                state.topicIndex = {};
                for (let key in state.metadataCache) {
                    let top = state.metadataCache[key].topic;
                    if (!state.topicIndex[top]) state.topicIndex[top] = [];
                    state.topicIndex[top].push(key);
                }
                return Object.keys(state.topicIndex).length;
            },
            indexDifficulty: function() {
                state.difficultyIndex = {};
                for (let key in state.metadataCache) {
                    let diff = state.metadataCache[key].difficulty;
                    if (!state.difficultyIndex[diff]) state.difficultyIndex[diff] = [];
                    state.difficultyIndex[diff].push(key);
                }
                return Object.keys(state.difficultyIndex).length;
            },
           getScanSummary: function() {
                return {
                    totalQuestions: state.questionPool.length,
                    totalHistory: state.attemptHistory.length,
                    totalWrong: state.wrongQuestionPool.length,
                    totalSaved: state.savedQuestionPool.length,
                    totalMetadata: Object.keys(state.metadataCache).length,
                    totalSubjects: Object.keys(state.subjectIndex).length,
                    totalTopics: Object.keys(state.topicIndex).length
                };
            },
            analyzeSubjects: function() {
                let analysis = {};
                for (let key in state.subjectIndex) {
                    let total = state.subjectIndex[key].length;
                    let wrongCount = state.wrongQuestionPool.filter(q => (q.section || q.subject || "General") === key).length;
                    analysis[key] = { total: total, wrong: wrongCount, errorRate: total > 0 ? (wrongCount / total) : 0 };
                }
                return analysis;
            },
            analyzeTopics: function() {
                let analysis = {};
                for (let key in state.topicIndex) {
                    let total = state.topicIndex[key].length;
                    let wrongCount = state.wrongQuestionPool.filter(q => (q.topic || "Uncategorized") === key).length;
                    analysis[key] = { total: total, wrong: wrongCount, errorRate: total > 0 ? (wrongCount / total) : 0 };
                }
                return analysis;
            },
            analyzeDifficulty: function() {
                let analysis = {};
                for (let key in state.difficultyIndex) {
                    let total = state.difficultyIndex[key].length;
                    let wrongCount = state.wrongQuestionPool.filter(q => (q.difficulty || "Medium") === key).length;
                    analysis[key] = { total: total, wrong: wrongCount, errorRate: total > 0 ? (wrongCount / total) : 0 };
                }
                return analysis;
            },
            calculateAccuracy: function() {
                if (!state.attemptHistory || state.attemptHistory.length === 0) return 0;
                let totalAcc = state.attemptHistory.reduce((sum, test) => sum + (parseFloat(test.accuracy) || 0), 0);
                return totalAcc / state.attemptHistory.length;
            },
            calculateCoverage: function() {
                let totalQs = state.questionPool.length;
                if (totalQs === 0) return 0;
                let available = this.calculateAvailability();
                return ((totalQs - available) / totalQs) * 100;
            },
            calculateWeakSubjects: function() {
                let subs = this.analyzeSubjects();
                return Object.keys(subs).sort((a, b) => subs[b].errorRate - subs[a].errorRate).slice(0, 3);
            },
            calculateStrongSubjects: function() {
                let subs = this.analyzeSubjects();
                return Object.keys(subs).sort((a, b) => subs[a].errorRate - subs[b].errorRate).slice(0, 3);
            },
            calculateWeakTopics: function() {
                let tops = this.analyzeTopics();
                return Object.keys(tops).sort((a, b) => tops[b].errorRate - tops[a].errorRate).slice(0, 5);
            },
            calculateStrongTopics: function() {
                let tops = this.analyzeTopics();
                return Object.keys(tops).sort((a, b) => tops[a].errorRate - tops[b].errorRate).slice(0, 5);
            },
            calculateDifficultyDistribution: function() {
                let dist = {};
                for (let key in state.difficultyIndex) {
                    dist[key] = state.difficultyIndex[key].length;
                }
                return dist;
            },
            calculateAvailability: function() {
                let usedKeys = new Set([
                    ...state.wrongQuestionPool.map(q => q._key || q.id),
                    ...state.savedQuestionPool.map(q => q._key || q.id)
                ]);
                return state.questionPool.filter(q => !usedKeys.has(q._key || q.id)).length;
            },
            generateAnalysisSummary: function() {
                state.statistics.analysis = {
                    accuracy: this.calculateAccuracy(),
                    coverage: this.calculateCoverage(),
                    weakSubjects: this.calculateWeakSubjects(),
                    strongSubjects: this.calculateStrongSubjects(),
                    weakTopics: this.calculateWeakTopics(),
                    strongTopics: this.calculateStrongTopics(),
                    difficultyDistribution: this.calculateDifficultyDistribution(),
                    availability: this.calculateAvailability()
                };
                return state.statistics.analysis;
            },
            _populateAnalysisCache: function() {
                if (!state.analysisCache) {
                    state.analysisCache = {
                        subjectAnalysis: this.analyzeSubjects(),
                        topicAnalysis: this.analyzeTopics(),
                        difficultyAnalysis: this.analyzeDifficulty(),
                        availability: this.calculateAvailability(),
                        summary: this.generateAnalysisSummary()
                    };
                }
                return state.analysisCache;
            },
           _generateRef: function(key) {
                let meta = state.metadataCache[key];
                if (!meta) return String(key);
                let sec = (meta.section || 'gen').replace(/[^a-zA-Z0-9]/g, '');
                let top = (meta.topic || 'unk').replace(/[^a-zA-Z0-9]/g, '');
                let diff = (meta.difficulty || 'med').replace(/[^a-zA-Z0-9]/g, '');
                let metadataIndex = String(key).replace(/[^a-zA-Z0-9]/g, '');
                
                if (!state._qMap) {
                    state._qMap = {};
                    let combined = [...state.questionPool, ...state.wrongQuestionPool, ...state.savedQuestionPool];
                    for (let i = 0; i < combined.length; i++) {
                        let q = combined[i];
                        if (q) state._qMap[q._key || q.id || ('auto_'+i)] = q;
                    }
                }
                
                let q = state._qMap[key];
                let testId = (q && q.originalTestId) ? "_" + String(q.originalTestId).replace(/[^a-zA-Z0-9]/g, '') : "";
                let ref = `ref_${sec}_${top}_${diff}_${metadataIndex}${testId}`.toLowerCase();
                
                if (!state.runtimeCache) state.runtimeCache = {};
                if (!state.runtimeCache.refToKey) state.runtimeCache.refToKey = {};
                state.runtimeCache.refToKey[ref] = key;
                
                return ref;
            },
            buildSubjectBlueprint: function(subject, count = 10) {
                this._populateAnalysisCache();
                let keys = state.subjectIndex[subject] || [];
                let refs = keys.slice(0, count).map(k => this._generateRef(k));
                return {
                    blueprintType: "Subject",
                    title: (subject || "Mixed") + " Mock",
                    questionCount: refs.length,
                    runtimeReferences: refs,
                    estimatedDifficulty: "Mixed",
                    estimatedTime: refs.length * 1.5,
                    statistics: { poolSize: keys.length }
                };
            },
            buildTopicBlueprint: function(topic, count = 10) {
                this._populateAnalysisCache();
                let keys = state.topicIndex[topic] || [];
                let refs = keys.slice(0, count).map(k => this._generateRef(k));
                return {
                    blueprintType: "Topic",
                    title: (topic || "Mixed") + " Mock",
                    questionCount: refs.length,
                    runtimeReferences: refs,
                    estimatedDifficulty: "Mixed",
                    estimatedTime: refs.length * 1.5,
                    statistics: { poolSize: keys.length }
                };
            },
            buildDifficultyBlueprint: function(difficulty, count = 10) {
                this._populateAnalysisCache();
                let keys = state.difficultyIndex[difficulty] || [];
                let refs = keys.slice(0, count).map(k => this._generateRef(k));
                return {
                    blueprintType: "Difficulty",
                    title: (difficulty || "Mixed") + " Mock",
                    questionCount: refs.length,
                    runtimeReferences: refs,
                    estimatedDifficulty: difficulty || "Mixed",
                    estimatedTime: refs.length * 1.5,
                    statistics: { poolSize: keys.length }
                };
            },
            buildWrongQuestionBlueprint: function(count = 10) {
                this._populateAnalysisCache();
                let refs = [];
                let pool = state.wrongQuestionPool || [];
                for(let i=0; i<Math.min(count, pool.length); i++) {
                    let q = pool[i];
                    refs.push(this._generateRef(q._key || q.id || ('auto_'+i)));
                }
                return {
                    blueprintType: "WrongQuestions",
                    title: "Mistakes Revision Mock",
                    questionCount: refs.length,
                    runtimeReferences: refs,
                    estimatedDifficulty: "High",
                    estimatedTime: refs.length * 1.5,
                    statistics: { poolSize: pool.length }
                };
            },
            buildSavedQuestionBlueprint: function(count = 10) {
                this._populateAnalysisCache();
                let refs = [];
                let pool = state.savedQuestionPool || [];
                for(let i=0; i<Math.min(count, pool.length); i++) {
                    let q = pool[i];
                    refs.push(this._generateRef(q._key || q.id || ('auto_'+i)));
                }
                return {
                    blueprintType: "SavedQuestions",
                    title: "Saved Questions Mock",
                    questionCount: refs.length,
                    runtimeReferences: refs,
                    estimatedDifficulty: "Mixed",
                    estimatedTime: refs.length * 1.5,
                    statistics: { poolSize: pool.length }
                };
            },
            buildRevisionBlueprint: function(count = 10) {
                this._populateAnalysisCache();
                let mixed = [...(state.wrongQuestionPool || []), ...(state.savedQuestionPool || [])];
                let uniqueKeys = new Set();
                let refs = [];
                for(let i=0; i<mixed.length && refs.length < count; i++) {
                    let q = mixed[i];
                    let key = q._key || q.id || ('auto_'+i);
                    if(!uniqueKeys.has(key)) {
                        uniqueKeys.add(key);
                        refs.push(this._generateRef(key));
                    }
                }
                return {
                    blueprintType: "Revision",
                    title: "Smart Revision Mock",
                    questionCount: refs.length,
                    runtimeReferences: refs,
                    estimatedDifficulty: "Mixed",
                    estimatedTime: refs.length * 1.5,
                    statistics: { poolSize: uniqueKeys.size }
                };
            },
            buildBlueprint: function(type, param, count = 10) {
                let bp = null;
                switch(type) {
                    case 'Subject': bp = this.buildSubjectBlueprint(param, count); break;
                    case 'Topic': bp = this.buildTopicBlueprint(param, count); break;
                    case 'Difficulty': bp = this.buildDifficultyBlueprint(param, count); break;
                    case 'WrongQuestions': bp = this.buildWrongQuestionBlueprint(count); break;
                    case 'SavedQuestions': bp = this.buildSavedQuestionBlueprint(count); break;
                    case 'Revision': bp = this.buildRevisionBlueprint(count); break;
                    default: return null;
                }
                state.runtimeBlueprint = bp;
                return bp;
            },
            validateBlueprint: function() {
                if (!state.runtimeBlueprint) return false;
                if (!state.runtimeBlueprint.runtimeReferences || state.runtimeBlueprint.runtimeReferences.length === 0) return false;
                return true;
            },
            getBlueprintSummary: function() {
                if (!state.runtimeBlueprint) return null;
                return {
                    type: state.runtimeBlueprint.blueprintType,
                    title: state.runtimeBlueprint.title,
                    count: state.runtimeBlueprint.questionCount,
                    difficulty: state.runtimeBlueprint.estimatedDifficulty,
                    time: state.runtimeBlueprint.estimatedTime
                };
            },
            build: function(type, param, count) {
                return this.buildBlueprint(type, param, count);
            },
            prepareRuntimeQuestionList: function(refs) {
                let wrappers = [];
                for (let i = 0; i < refs.length; i++) {
                    let ref = refs[i];
                    let key = (state.runtimeCache && state.runtimeCache.refToKey) ? state.runtimeCache.refToKey[ref] : null;
                    if (!key) continue;
                    let originalQ = state._qMap[key];
                    let meta = state.metadataCache[key] || {};
                    if (originalQ) {
                        wrappers.push({
                            runtimeRef: ref,
                            questionRef: originalQ,
                            section: meta.section,
                            topic: meta.topic,
                            difficulty: meta.difficulty,
                            metadataIndex: key,
                            runtimeStatus: 'pending'
                        });
                    }
                }
                return wrappers;
            },
            generateRuntimeMock: function(blueprint) {
                if (!blueprint) return null;
                let questions = this.prepareRuntimeQuestionList(blueprint.runtimeReferences || []);
                let mock = {
                    mockTitle: blueprint.title,
                    mockType: blueprint.blueprintType,
                    questionCount: blueprint.questionCount,
                    estimatedTime: blueprint.estimatedTime,
                    estimatedDifficulty: blueprint.estimatedDifficulty,
                    runtimeReferences: blueprint.runtimeReferences,
                    runtimeQuestions: questions,
                    statistics: blueprint.statistics,
                    status: 'generated'
                };
                if (!state.runtimeCache) state.runtimeCache = {};
                state.runtimeCache.currentMock = mock;
                return mock;
            },
            generateSubjectMock: function(subject, count = 10) {
                return this.generateRuntimeMock(this.buildSubjectBlueprint(subject, count));
            },
            generateTopicMock: function(topic, count = 10) {
                return this.generateRuntimeMock(this.buildTopicBlueprint(topic, count));
            },
            generateDifficultyMock: function(difficulty, count = 10) {
                return this.generateRuntimeMock(this.buildDifficultyBlueprint(difficulty, count));
            },
            generateWrongQuestionMock: function(count = 10) {
                return this.generateRuntimeMock(this.buildWrongQuestionBlueprint(count));
            },
            generateSavedQuestionMock: function(count = 10) {
                return this.generateRuntimeMock(this.buildSavedQuestionBlueprint(count));
            },
            generateRevisionMock: function(count = 10) {
                return this.generateRuntimeMock(this.buildRevisionBlueprint(count));
            },
            validateRuntimeMock: function() {
                let m = state.runtimeCache && state.runtimeCache.currentMock;
                return !!(m && m.runtimeQuestions && m.runtimeQuestions.length > 0 && m.status === 'generated');
            },
            getRuntimeMockSummary: function() {
                let m = state.runtimeCache && state.runtimeCache.currentMock;
                if (!m) return null;
                return {
                    title: m.mockTitle,
                    type: m.mockType,
                    count: m.questionCount,
                    status: m.status
                };
            },
            validateRuntimeReferences: function(mock) {
                if (!mock || !mock.runtimeReferences || !mock.runtimeQuestions) return false;
                let valid = true;
                let seen = new Set();
                for (let ref of mock.runtimeReferences) {
                    if (!ref || seen.has(ref) || !state.runtimeCache.refToKey[ref] || !state._qMap[state.runtimeCache.refToKey[ref]]) {
                        valid = false; break;
                    }
                    seen.add(ref);
                }
                return valid && (mock.runtimeReferences.length === mock.runtimeQuestions.length);
            },
            removeDuplicateReferences: function(mock) {
                if (!mock || !mock.runtimeReferences) return mock;
                let uniqueRefs = [...new Set(mock.runtimeReferences)];
                let uniqueQs = [];
                let seenRef = new Set();
                for(let i = 0; i < (mock.runtimeQuestions || []).length; i++) {
                    let rq = mock.runtimeQuestions[i];
                    if(!seenRef.has(rq.runtimeRef)) {
                        seenRef.add(rq.runtimeRef);
                        uniqueQs.push(rq);
                    }
                }
                mock.runtimeReferences = uniqueRefs;
                mock.runtimeQuestions = uniqueQs;
                return mock;
            },
            removeInvalidReferences: function(mock) {
                if (!mock || !mock.runtimeReferences) return mock;
                let validRefs = [];
                let validQs = [];
                for(let i = 0; i < (mock.runtimeQuestions || []).length; i++) {
                    let rq = mock.runtimeQuestions[i];
                    if(rq && rq.questionRef && rq.metadataIndex && state._qMap[rq.metadataIndex]) {
                        validRefs.push(rq.runtimeRef);
                        validQs.push(rq);
                    }
                }
                mock.runtimeReferences = validRefs;
                mock.runtimeQuestions = validQs;
                return mock;
            },
            recoverMissingQuestions: function(mock) {
                if (!mock || !mock.runtimeReferences || !mock.runtimeQuestions) return mock;
                let deficit = mock.questionCount - mock.runtimeReferences.length;
                if (deficit <= 0) return mock;
                
                // Safe recovery: Fetch missing from revision pool as fallback
                let mixed = [...(state.wrongQuestionPool || []), ...(state.savedQuestionPool || [])];
                let currentSet = new Set(mock.runtimeReferences);
                for (let i = 0; i < mixed.length && deficit > 0; i++) {
                    let q = mixed[i];
                    let key = q._key || q.id || ('auto_'+i);
                    let ref = this._generateRef(key);
                    if (!currentSet.has(ref)) {
                        currentSet.add(ref);
                        mock.runtimeReferences.push(ref);
                        let meta = state.metadataCache[key] || {};
                        mock.runtimeQuestions.push({
                            runtimeRef: ref,
                            questionRef: q,
                            section: meta.section,
                            topic: meta.topic,
                            difficulty: meta.difficulty,
                            metadataIndex: key,
                            runtimeStatus: 'pending'
                        });
                        deficit--;
                    }
                }
                return mock;
            },
            recoverInvalidTopics: function(mock) {
                if (!mock || !mock.runtimeQuestions) return mock;
                mock.runtimeQuestions.forEach(rq => {
                    if (!rq.topic || rq.topic.trim() === '') rq.topic = "Uncategorized";
                });
                return mock;
            },
            recoverInvalidSubjects: function(mock) {
                if (!mock || !mock.runtimeQuestions) return mock;
                mock.runtimeQuestions.forEach(rq => {
                    if (!rq.section || rq.section.trim() === '') rq.section = "General";
                });
                return mock;
            },
            recoverCorruptedMetadata: function(mock) {
                if (!mock || !mock.runtimeQuestions) return mock;
                this.recoverInvalidSubjects(mock);
                this.recoverInvalidTopics(mock);
                mock.runtimeQuestions.forEach(rq => {
                    if (!rq.difficulty || rq.difficulty.trim() === '') rq.difficulty = "Medium";
                });
                return mock;
            },
            validateRuntimeStatistics: function(mock) {
                if (!mock) return mock;
                mock.statistics = mock.statistics || {};
                mock.statistics.actualQuestionCount = mock.runtimeQuestions ? mock.runtimeQuestions.length : 0;
                mock.estimatedTime = mock.statistics.actualQuestionCount * 1.5;
                mock.questionCount = mock.statistics.actualQuestionCount;
                return mock;
            },
            fallbackToRevisionMock: function() {
                state.statistics.validation = state.statistics.validation || { repairs: 0, fallbacks: 0 };
                state.statistics.validation.fallbacks++;
                console.log("SmartMockEngine: Validation failed, falling back to Revision Mock.");
                return this.generateRevisionMock(10);
            },
            repairRuntimeMock: function() {
                let mock = state.runtimeCache && state.runtimeCache.currentMock;
                if (!mock) return this.fallbackToRevisionMock();
                
                state.statistics.validation = state.statistics.validation || { repairs: 0, fallbacks: 0 };
                
                if (this.validateRuntimeReferences(mock)) {
                    return mock; // Already valid, no repair needed
                }
                
                try {
                    state.statistics.validation.repairs++;
                    mock = this.removeDuplicateReferences(mock);
                    mock = this.removeInvalidReferences(mock);
                    mock = this.recoverCorruptedMetadata(mock);
                    mock = this.recoverMissingQuestions(mock);
                    mock = this.validateRuntimeStatistics(mock);
                    
                    if (!mock.runtimeQuestions || mock.runtimeQuestions.length === 0) {
                        return this.fallbackToRevisionMock();
                    }
                    
                    state.runtimeCache.currentMock = mock;
                    mock.status = 'repaired';
                    return mock;
                } catch (e) {
                    console.error("SmartMockEngine: Repair crashed safely.", e);
                    return this.fallbackToRevisionMock();
                }
            },
            generate: function(type, param, count = 10) {
                switch(type) {
                    case 'Subject': return this.generateSubjectMock(param, count);
                    case 'Topic': return this.generateTopicMock(param, count);
                    case 'Difficulty': return this.generateDifficultyMock(param, count);
                    case 'WrongQuestions': return this.generateWrongQuestionMock(count);
                    case 'SavedQuestions': return this.generateSavedQuestionMock(count);
                    case 'Revision': return this.generateRevisionMock(count);
                    default: return null;
                }
            },
            launch: function() {

    let mock = state.runtimeCache && state.runtimeCache.currentMock;

    if (!this.validateRuntimeMock()) {
        mock = this.repairRuntimeMock();
    }

    if (!mock || !mock.runtimeReferences) {
        return {
            status: "error",
            message: "Runtime mock unavailable."
        };
    }

    mock.runtimeQuestions = this.prepareRuntimeQuestionList(
        mock.runtimeReferences
    );

    return {
        status: "success",
        activeMock: mock
    };

},
            validate: function() {
                console.log("SmartMockEngine: validate() called. Placeholder logic executed.");
                return state.engineReady;
            },
            clearCache: function() {
                console.log("SmartMockEngine: clearCache() called.");
                state.runtimeCache = {};
                state.analysisCache = null; 
                return true;
            },
            getStats: function() {
                return state.statistics;
            }
        };
})();


