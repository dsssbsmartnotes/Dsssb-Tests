// 🚀 SMART MERGE ENGINE: Modifies behavior based on custom selection
window.syncGitHubTopicsBackground = async function(isMergeMode = false) {
    if (!isMergeMode) {
        let cached = localStorage.getItem('pyq_github_topics_cache_v2');
        if (cached) {
            try {
                let parsed = JSON.parse(cached);
                if (Date.now() - parsed.timestamp < 86400000) {
                    window.proQuizDataMap = parsed.data;
                    window.renderProQuizDropdowns();
                    return;
                }
            } catch(e){}
        }
    }

    if (typeof allTests === 'undefined' || !Array.isArray(allTests) || allTests.length === 0) return;

    try {
        let testsToScan = isMergeMode ? window.selectedMergeTests : allTests.slice(0, 20);

        if(isMergeMode) {
            let subSelect = document.getElementById('proQuizSubject');
            if(subSelect) subSelect.innerHTML = '<option value="ALL">Extracting EXACT Topics...</option>';
        }

        let fetchPromises = testsToScan.map(t => 
            fetch(`https://raw.githubusercontent.com/amit-cbt-admin/Dsssb-Tests/main/tests/${t.dbKey}.json`)
            .then(res => res.ok ? res.json() : null).catch(() => null)
        );

        let fetchedData = await Promise.all(fetchPromises);
        let dataMap = {};

        fetchedData.forEach(testQs => {
            if (testQs && Array.isArray(testQs)) {
                testQs.forEach(q => {
                    let sec = (q.section || "General").trim();
                    let top = (q.topic || "").trim();
                    
                    if (!dataMap[sec]) dataMap[sec] = [];
                    if (top !== "" && !dataMap[sec].includes(top)) {
                        dataMap[sec].push(top);
                    }
                });
            }
        });

        if (Object.keys(dataMap).length > 0) {
            window.proQuizDataMap = dataMap;
            if(!isMergeMode) {
                localStorage.setItem('pyq_github_topics_cache_v2', JSON.stringify({ timestamp: Date.now(), data: dataMap }));
            }
            window.renderProQuizDropdowns();
        } else if (isMergeMode) {
            window.proQuizDataMap = {"General": []}; // Fallback if selected tests have no tags
            window.renderProQuizDropdowns();
        }
    } catch(e) { console.warn("Background topic sync failed:", e); }
};

window.renderProQuizDropdowns = function() {
        let subContainer = document.getElementById('proQuizSubject');
        if(!subContainer) return;
        
        let html = '<label style="color:#fff; font-size:13px; display:flex; align-items:center; gap:8px; cursor:pointer;"><input type="checkbox" value="ALL" class="sub-chk" onchange="window.handleProSubChange(this)" checked style="accent-color:#ffd700; width:16px; height:16px;"> <b>All Subjects</b></label>';
        Object.keys(window.proQuizDataMap).sort().forEach(sec => {
            html += `<label style="color:#fff; font-size:13px; display:flex; align-items:center; gap:8px; cursor:pointer;"><input type="checkbox" value="${sec}" class="sub-chk" onchange="window.handleProSubChange(this)" style="accent-color:#ffd700; width:16px; height:16px;"> ${sec}</label>`;
        });
        subContainer.innerHTML = html;
        window.updateProQuizTopicsUI();
    };

    window.handleProSubChange = function(el) {
        let checkboxes = document.querySelectorAll('.sub-chk');
        if(el.value === "ALL" && el.checked) {
            checkboxes.forEach(cb => { if(cb.value !== "ALL") cb.checked = false; });
        } else if (el.checked) {
            let allCb = document.querySelector('.sub-chk[value="ALL"]');
            if(allCb) allCb.checked = false;
        }
        
        // Agar galti se saare uncheck ho gaye, toh "ALL" ko wapas check kar do
        if(Array.from(checkboxes).every(cb => !cb.checked)) {
            let allCb = document.querySelector('.sub-chk[value="ALL"]');
            if(allCb) allCb.checked = true;
        }
        window.updateProQuizTopicsUI();
    };

    window.updateProQuizTopicsUI = function() {
        let subCheckboxes = Array.from(document.querySelectorAll('.sub-chk:checked')).map(cb => cb.value);
        let topContainer = document.getElementById('proQuizTopic');
        if(!topContainer) return;
        
        let html = '<label style="color:#fff; font-size:13px; display:flex; align-items:center; gap:8px; cursor:pointer;"><input type="checkbox" value="ALL" class="top-chk" onchange="window.handleProTopChange(this)" checked style="accent-color:#ffd700; width:16px; height:16px;"> <b>All Topics</b></label>';
        
        let allTopics = new Set();
        if (subCheckboxes.includes("ALL") || subCheckboxes.length === 0) {
            Object.values(window.proQuizDataMap).forEach(arr => arr.forEach(t => allTopics.add(t)));
        } else {
            subCheckboxes.forEach(sec => {
