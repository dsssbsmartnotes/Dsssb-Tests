function createOfflineAIEngine() {
    return {
        engineStatus: "initialized",
        mode: "offline",
        version: "1.0",
        lastAnalysis: null
    };
}

function analyzeSectionPerformance(questionsData, userAnswers) {
    let stats = {};
    if (!questionsData || !Array.isArray(questionsData)) return stats;
    questionsData.forEach((q, index) => {
        let sec = q.section || q.sectionName || q.subject || "General";
        if (!stats[sec]) stats[sec] = { total: 0, attempted: 0, correct: 0, wrong: 0, skipped: 0, accuracy: 0 };
        stats[sec].total += 1;
        
        let qId = q.id || q.questionId || index;
        let ans = userAnswers ? (userAnswers[qId] || userAnswers[index]) : null;
        let isAttempted = ans && ans.selectedOption != null && ans.selectedOption !== "";
        let isCorrect = isAttempted && String(ans.selectedOption) === String(q.correctAnswer || q.answer);
        
        if (isAttempted) {
            stats[sec].attempted += 1;
            if (isCorrect) stats[sec].correct += 1;
            else stats[sec].wrong += 1;
        } else {
            stats[sec].skipped += 1;
        }
    });
    for (let sec in stats) {
        stats[sec].accuracy = stats[sec].attempted > 0 ? (stats[sec].correct / stats[sec].attempted) * 100 : 0;
    }
    return stats;
}

