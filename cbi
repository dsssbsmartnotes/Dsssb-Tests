          correct++; 
          totalScore += POSITIVE_MARK; 
          sectionScores[secName].c++; 
          topicStats[topicName].c++;
          if(mistakesDiary[qKey]) delete mistakesDiary[qKey];
      } else { 
          wrong++; 
