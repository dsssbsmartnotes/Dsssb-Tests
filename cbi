function getRanksAndToppers(myScore, myTime) {
  return db.ref(DB_REF_NAME).orderByChild("testId").equalTo(CURRENT_TEST_ID).once("value").then(snapshot => {
      let attempts = [];
      snapshot.forEach(child => {
          const val = child.val();
          if(val && val.score !== undefined) { attempts.push(val); }
      });
      
      let userBest = {};
      attempts.forEach(a => {
          let k = a.userId || a.name;
          if(!userBest[k]) {
              userBest[k] = a;
          } else {
              if(a.score > userBest[k].score || (a.score === userBest[k].score && a.timeTaken < userBest[k].timeTaken)) {
                  userBest[k] = a;
              }
          }
      });
      
      let uniqueAttempts = Object.values(userBest);
      
      uniqueAttempts.sort((a, b) => {
          if (b.score !== a.score) return b.score - a.score;
          return a.timeTaken - b.timeTaken;
      });
      
      const total = uniqueAttempts.length;
      let rank = total + 1; 
      for (let i = 0; i < uniqueAttempts.length; i++) {
          if (uniqueAttempts[i].score === myScore && uniqueAttempts[i].timeTaken === myTime) { rank = i + 1; break; }
      }
     
      const below = uniqueAttempts.filter(a => a.score < myScore || (a.score === myScore && a.timeTaken > myTime)).length;
      const percentile = total ? ((below / total) * 100).toFixed(2) : "0.00";
     
      return { rank, percentile, total, toppersList: uniqueAttempts.slice(0, 10) };
  }).catch(() => {
      // Fallback for offline mode rank calculation to prevent hanging
      return { rank: '--', percentile: '0.00', total: '--', toppersList: [] };
  });
}

