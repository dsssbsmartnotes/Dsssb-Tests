function manualSubmitSection() {
    if(currentState.submitted || TEST_MODE === 'quiz') return;

    let timeSpentSec = (TOTAL_TIME_MINS * 60) - currentState.time;
    if (MIN_SUBMIT_MINS > 0 && timeSpentSec < (MIN_SUBMIT_MINS * 60)) {
        let remainSec = (MIN_SUBMIT_MINS * 60) - timeSpentSec;
        let m = Math.floor(remainSec / 60);
        let s = remainSec % 60;
        return showToast(`कृपया सबमिट करने के लिए ${m} मिनट ${s} सेकंड और प्रतीक्षा करें!`, "warning");
    }

    if (currentState.secIdx < SECTION_MAP.length - 1) {
        const currentSecName = SECTION_MAP[currentState.secIdx];
        showConfirmDialog(
            "Submit Section?", 
            `Are you sure you want to submit the '${currentSecName}' section? You cannot modify answers in this section later.`,
            () => {
                currentState.secIdx++; 
                renderSectionTabs(); 
                loadQuestion(secIndices[currentState.secIdx]);
                if(window.innerWidth < 1024) togglePalette();
            }
        );
    } else {
        submitTestDialog();
    }
}

function submitTestDialog() {
  if(currentState.submitted) return;

  let timeSpentSec = (TOTAL_TIME_MINS * 60) - currentState.time;
  if (MIN_SUBMIT_MINS > 0 && timeSpentSec < (MIN_SUBMIT_MINS * 60)) {
      let remainSec = (MIN_SUBMIT_MINS * 60) - timeSpentSec;
      let m = Math.floor(remainSec / 60);
      let s = remainSec % 60;
      return showToast(`टेस्ट सबमिट करने के लिए ${m} मिनट ${s} सेकंड और प्रतीक्षा करें!`, "warning");
