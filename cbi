async function generateAndSaveSolution(testId, qIndex) {
    const btnBox = document.getElementById(`ai_sol_box_${qIndex}`);
    btnBox.innerHTML = `<p style='color:var(--warning); font-weight:bold; font-size:13px;'>⏳ AI is analyzing the question and writing the best solution...</p>`;

    try {
        const qData = QUESTIONS[qIndex];
        const generatedHtml = await fetchAISolution(qData);

        btnBox.innerHTML = `<b>💡 AI Explanation:</b><br><div style="margin-top:8px;">${generatedHtml}</div>`;
        btnBox.style.border = "none";
        btnBox.style.background = "transparent";
        btnBox.style.padding = "0";

  QUESTIONS[qIndex].solution = generatedHtml;
        showToast("AI Solution Generated! ✅", "success");      

    } catch (error) {
        btnBox.innerHTML = `<p style="color:var(--danger); font-size:13px;">❌ Error: ${error.message}</p>
        <button onclick="generateAndSaveSolution('${testId}', ${qIndex})" style="padding:6px 12px; border-radius:6px; cursor:pointer;">Retry</button>`;
    }
}

async function fetchAISolution(qData) {
    const isHindi = document.getElementById('langBtn').innerText === "HI";
    const qText = isHindi ? (qData.q_hi || qData.q_en) : (qData.q_en || qData.q_hi);
    const optsArr = isHindi ? (qData.op_hi || qData.op_en) : (qData.op_en || qData.op_hi);
    
    const correctAnsOption = qData.ans;
    const correctAnsText = optsArr[parseInt(qData.ans) - 1];

    const prompt = `You are a strict exam solution generator.
    QUESTION: ${qText}
    OPTIONS: 
    1) ${optsArr[0]} 
    2) ${optsArr[1]} 
    3) ${optsArr[2]} 
    4) ${optsArr[3]}

    OFFICIAL CORRECT ANSWER: Option ${correctAnsOption} (${correctAnsText})

    INSTRUCTIONS (STRICT - NO DEVIATION):
    1. OUTPUT FORMAT: Return ONLY clean HTML (no markdown, no extra text, do not wrap in \`\`\`html). MUST start with <ul> and end with </ul>. Inside <ul>, give EXACTLY 2 (max 3) <li> points.
    2. EXTREME BREVITY: Each <li> MUST BE EXTREMELY SHORT.
    3. LANGUAGE RULE: Explain in Hinglish (Hindi in Latin script).
    4. MATH RULE: Use LaTeX inside $ and $$. DO NOT USE html math tags.
    Generate the shortest possible correct HTML list now.`;

    const rawHtml = await callGemini(prompt);
    return rawHtml.split('```html').join('').split('```').join('').trim();
}

