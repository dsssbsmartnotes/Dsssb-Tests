  const analysisData = {
      correct: correct,
      wrong: wrong,
      skipped: skipped,
      avgTime: attempted > 0 ? Math.round(timeSpentSeconds / attempted) : 0,
      fastestTime: fastest,
      slowestTime: slowest,
      topicPerformance: topicStats
  };
  
  if (!isViewOnly) {
      await setItemDB('dsssb_analysis_data', JSON.stringify(analysisData));
      await setItemDB('dsssb_replay_qs', JSON.stringify(QUESTIONS));
