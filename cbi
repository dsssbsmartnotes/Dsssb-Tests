function next() {
  if(currentState.idx < QUESTIONS.length - 1) {
      if (currentState.submitted || TEST_MODE === 'quiz') {
          loadQuestion(currentState.idx + 1);
          return;
      }

      const nextQ = QUESTIONS[currentState.idx + 1]; 
      const currQ = QUESTIONS[currentState.idx];
      if((nextQ.section || "General") !== (currQ.section || "General")) {
          if (SECTION_LOCK) {
              showConfirmDialog(
                  "Submit Section?", 
                  `Are you sure you want to finish the ${currQ.section || "General"} section? You cannot modify answers in this section later.`,
                  () => {
                      currentState.secIdx++; 
                      renderSectionTabs(); 
                      loadQuestion(currentState.idx + 1);
                  }
              );
          } else {
              currentState.secIdx++; 
              renderSectionTabs(); 
              loadQuestion(currentState.idx + 1);
          }
      } else { 
          loadQuestion(currentState.idx + 1); 
      }
  } else { 
      if(TEST_MODE === 'quiz') {
          showToast("Quiz Completed! Returning home...", "success");
          setTimeout(() => { window.location.href = "index.html"; }, 1500);
      } else if(!currentState.submitted) {
          submitTestDialog();
      } else {
          showToast("End of Questions. Redirecting to Dashboard...", "info");
          setTimeout(() => { window.location.href = "index.html"; }, 1500);
      }
  }
}

function prev() {
  if (currentState.submitted || TEST_MODE === 'quiz') {
      if(currentState.idx > 0) loadQuestion(currentState.idx - 1);
      return;
  }
  const currQ = QUESTIONS[currentState.idx];
  if(currentState.idx > 0) {
      const prevQ = QUESTIONS[currentState.idx - 1];
      if((prevQ.section || "General") === (currQ.section || "General")) { 
          loadQuestion(currentState.idx - 1); 
      } 
      else { 
          if(SECTION_LOCK) {
              showToast("You are in a locked section flow! Cannot go back.", "warning"); 
          } else {
              currentState.secIdx--;
              renderSectionTabs();
              loadQuestion(currentState.idx - 1);
          }
      }
  }
}

