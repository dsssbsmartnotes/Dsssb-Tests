                          neededTests[tId].forEach(ref => {
                              const index = ref.questionIndex ?? ref.qIndex ?? 0;

if (qs[index]) {

    // Map and clone to avoid reference mutation
    let q = Object.assign({}, qs[index]);

    q.originalTestId = tId;

    q.originalIndex = index;

    q.section = ref.section || q.section || "Smart Mock";

    q.topic = ref.topic || q.topic || "";

    q.language = ref.language || q.language || "en";

    combinedQs.push(q);

}
                          });
                      }
                  } catch(e) { console.warn("Failed loading component test reference for AI Mock:", tId); }
              }
              
              if (combinedQs.length > 0) return combinedQs;
          } catch(e) {
