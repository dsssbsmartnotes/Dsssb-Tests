      }
      html += `<div class="${cls}" onclick="jumpSection(${i})">${icon} ${sec}</div>`;
  });
  
  // Naya Hide/Show Palette Button Section Bar ke Right Side mein
  html += `<div style="flex:1;"></div><button onclick="togglePalette()" class="sec-tab" style="background:var(--primary-light); color:var(--primary-dark); font-weight:800; border:1px solid var(--primary); padding: 0 12px; margin-right: 5px;" title="Hide/Show Palette"><i class="fas fa-columns"></i></button>`;
  
