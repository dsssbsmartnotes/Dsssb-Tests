let touchendY = 0;

document.getElementById('mainArea').addEventListener('touchstart', e => { 
    touchstartX = e.changedTouches[0].screenX; 
    touchstartY = e.changedTouches[0].screenY; 
}, {passive: true});

document.getElementById('mainArea').addEventListener('touchend', e => { 
    let el = e.target;
    let isScrollable = false;
    
    while (el && el !== document.getElementById('mainArea')) {
        if ((el.classList && (el.classList.contains('q-text') || el.classList.contains('opt'))) || el.tagName === 'TABLE' || el.tagName === 'IMG') {
            if (el.scrollWidth > el.clientWidth + 2) { 
                isScrollable = true;
                break;
            }
        }
        el = el.parentElement;
    }

    if (isScrollable || e.target.tagName === 'IMG') {
        return;
    }

    touchendX = e.changedTouches[0].screenX; 
    touchendY = e.changedTouches[0].screenY; 
    
    if (Math.abs(touchendY - touchstartY) < 60) {
        if(touchendX < touchstartX - 80) next(); 
        if(touchendX > touchstartX + 80) prev(); 
    }
}, {passive: true});

