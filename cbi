        </div>`;
        container.insertAdjacentHTML('beforeend', filterHtml);
    }

    SECTION_MAP.forEach((sec, secIndex) => {
        let startIdx = secIndices[secIndex];
        let endIdx = (secIndex === SECTION_MAP.length - 1) ? QUESTIONS.length : secIndices[secIndex + 1];
        
        let secStats = { ans: 0, unans: 0, rev: 0, unseen: 0, correct: 0, wrong: 0, skipped: 0 };
        let gridHtml = `<div class="${isPaletteListView ? 'p-list' : 'p-grid'}">`;
        let hasVisibleQuestions = false; 
        
        for(let i = startIdx; i < endIdx; i++) {
            const myAns = currentState.answers[i]; 
            let cls = "qbtn";
            
            let isQuizAnswered = (TEST_MODE === 'quiz' && myAns !== null);
            let isAccessible = currentState.submitted || TEST_MODE === 'quiz';
            
            if (!currentState.submitted && TEST_MODE !== 'quiz') {
                if (!SECTION_LOCK) isAccessible = true;
                else if (i >= secIndices[currentState.secIdx] && i < ((currentState.secIdx === SECTION_MAP.length - 1) ? QUESTIONS.length : secIndices[currentState.secIdx + 1])) { 
                    isAccessible = true; 
                }
            }

            let stateCls = "unseen";
            let statusText = "Unseen";
            let filterTypeMatch = "skipped"; 
            
            if (currentState.submitted || isQuizAnswered) {
                const correctIdx = parseInt(QUESTIONS[i].ans) - 1;
                if (myAns === correctIdx) { stateCls = "p-correct"; statusText = "Correct ✅"; filterTypeMatch = "correct"; secStats.correct++; }
                else if (myAns !== null && myAns !== correctIdx) { stateCls = "p-wrong"; statusText = "Wrong ❌"; filterTypeMatch = "wrong"; secStats.wrong++; }
                else { stateCls = "p-skip"; statusText = "Skipped 🟡"; filterTypeMatch = "skipped"; secStats.skipped++; }
                if(currentState.review[i]) { stateCls += " review"; statusText += " (Review)"; }
            } else {
                if(myAns !== null) { stateCls = "attempted"; statusText = "Attempted"; secStats.ans++; }
                else if(currentState.review[i]) { stateCls = "review"; statusText = "Review ★"; secStats.rev++; }
                else if(isAccessible && i <= currentState.idx && !(SECTION_LOCK && secIndex > currentState.secIdx)) { stateCls = "unattempted"; statusText = "Unattempted"; secStats.unans++; }
                else { stateCls = "unseen"; statusText = "Unseen"; secStats.unseen++; }
                
                if(i === currentState.idx) { stateCls += " current"; statusText = "Current 🟢"; }
            }

            if ((currentState.submitted || TEST_MODE === 'quiz') && paletteFilter !== 'all' && filterTypeMatch !== paletteFilter) {
                continue; 
            }
            
            hasVisibleQuestions = true;

            let styleStr = "";
            if(!isAccessible) {
                styleStr = 'opacity: 0.3; cursor: not-allowed; border-color: #334155;';
            } else {
                styleStr = 'cursor: pointer;';
            }

            if (isPaletteListView) {
                gridHtml += `<button class="qbtn-list ${stateCls}" style="${styleStr}" ${isAccessible ? `onclick="loadQuestion(${i}); if(window.innerWidth < 1024) togglePalette();"` : `disabled`}>
                    <span style="font-size:14px;">Q. ${i + 1}</span>
                    <span style="font-size:11px; text-transform:uppercase; letter-spacing:0.5px;">${statusText}</span>
                </button>`;
            } else {
                cls += " " + stateCls;
                gridHtml += `<button class="${cls}" style="${styleStr}" ${isAccessible ? `onclick="loadQuestion(${i}); if(window.innerWidth < 1024) togglePalette();"` : `disabled`}>${i + 1}</button>`;
            }
        }
        gridHtml += `</div>`;
        
        if (!hasVisibleQuestions && paletteFilter !== 'all') return;

        let isCollapsed = (secIndex !== currentState.secIdx); 
        if(currentState.submitted || TEST_MODE === 'quiz') isCollapsed = false;

        let statsHtml = "";
        if (currentState.submitted || TEST_MODE === 'quiz') {
            statsHtml = `
                <span style="color:var(--success)">✅ ${secStats.correct}</span>
                <span style="color:var(--danger)">❌ ${secStats.wrong}</span>
                <span style="color:var(--warning)">🟡 ${secStats.skipped}</span>
            `;
        } else {
            statsHtml = `
                <span style="color:#ef4444">★ ${secStats.rev}</span>
                <span style="color:#3b82f6">● ${secStats.ans}</span>
                <span style="color:#64748b">● ${secStats.unans}</span>
                <span style="color:#64748b; font-size:10px;">○ ${secStats.unseen}</span>
            `;
        }

        let secHtml = `
        <div class="p-sec-wrapper">
            <div class="p-sec-header ${isCollapsed ? 'collapsed' : ''}" onclick="this.classList.toggle('collapsed'); this.nextElementSibling.classList.toggle('collapsed');">
