            </div>
            <div class="p-sec-body ${isCollapsed ? 'collapsed' : ''}">
                <div class="p-sec-stats">
                    ${statsHtml}
                </div>
                ${gridHtml}
            </div>
        </div>
        `;
        container.insertAdjacentHTML('beforeend', secHtml);
    });
}

