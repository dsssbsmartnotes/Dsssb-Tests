<script>
/* =======================================================
   🔥 INDEXED DB ENGINE (FOR UNLIMITED OFFLINE STORAGE) 🔥
   ======================================================= */
const IDB_NAME = 'PYQNotes_CBT_DB';
const IDB_STORE = 'Store';

const initDB = () => new Promise((res, rej) => {
    const req = indexedDB.open(IDB_NAME, 1);
    req.onupgradeneeded = e => e.target.result.createObjectStore(IDB_STORE);
    req.onsuccess = e => res(e.target.result);
    req.onerror = e => rej(e.target.error);
});

async function setItemDB(key, val) {
    try {
        const db = await initDB();
        const tx = db.transaction(IDB_STORE, 'readwrite');
        tx.objectStore(IDB_STORE).put(val, key);
        return new Promise((res, rej) => { tx.oncomplete = () => res(true); tx.onerror = () => rej(tx.error); });
    } catch(e) {
        try { localStorage.setItem(key, val); } catch(e2) {} // Fallback
    }
}

async function getItemDB(key) {
    try {
        const db = await initDB();
        const tx = db.transaction(IDB_STORE, 'readonly');
        const req = tx.objectStore(IDB_STORE).get(key);
        return new Promise((res, rej) => {
            req.onsuccess = () => res(req.result);
            req.onerror = () => rej(req.error);
        });
    } catch(e) {
        try { return localStorage.getItem(key); } catch(e2) { return null; } // Fallback
    }
}

async function removeItemDB(key) {
    try {
        const db = await initDB();
        const tx = db.transaction(IDB_STORE, 'readwrite');
        tx.objectStore(IDB_STORE).delete(key);
        return new Promise((res, rej) => { tx.oncomplete = () => res(true); tx.onerror = () => rej(tx.error); });
    } catch(e) {
        try { localStorage.removeItem(key); } catch(e2) {} // Fallback
    }
}

// Global variable for rapid sync with bookmarks UI
let BOOKMARKS = {};

// 🔥 SMART MOCK ENGINE INTERCONNECTION RECEIVER 🔥
document.addEventListener('DOMContentLoaded', () => {
    const urlParams = new URLSearchParams(window.location.search);
    
    // Check karna ki kya user index.html se AI Mock start karke aaya hai
    if (urlParams.get('mode') === 'smart_mock') {
        const smartMockData = localStorage.getItem('pyq_active_smart_mock');
        
        if (smartMockData) {
            console.log("✅ Smart AI Mock Connected Successfully!");
            // Data global object mein feed karna taaki CBT usko read kar sake
            window.activeTestData = JSON.parse(smartMockData); 
        } else {
            console.warn("❌ Smart Mock data is missing!");
        }
    }
});
</script>

