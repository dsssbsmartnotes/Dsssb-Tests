function removeSafeData(key) { try { localStorage.removeItem(key); } catch(e) {} }

function showToast(msg, type="info") {
  const container = document.getElementById('toast-container'); 
  if(!container) return;
  const t = document.createElement('div'); t.className = `toast ${type}`;
  let icon = "ℹ️"; if(type==="success") icon = "✅"; if(type==="error") icon = "❌"; if(type==="warning") icon = "⚠️";
  t.innerHTML = `<span style="font-size: 16px;">${icon}</span> <span style="font-weight: 600;">${msg}</span>`; 
  container.appendChild(t); 
  setTimeout(() => t.remove(), 3000);
}

