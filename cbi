function startTimer() {
  clearInterval(timerInt);
  timerInt = setInterval(() => {
      if(currentState.submitted || isPaused) return; // 🔥 Agar exam paused hai, to time nahi ghatega
      
      if (TEST_MODE !== 'solution' && TEST_MODE !== 'quiz' && TEST_MODE !== 'result' && currentState.idx !== undefined) {
          currentState.timePerQ[currentState.idx] = (currentState.timePerQ[currentState.idx] || 0) + 1;
      }

      if(currentState.time <= 0) { submitTest(); return; }
      currentState.time--;

      // 🔥 LIVE PROGRESS BAR LOGIC 🔥
      let totalSeconds = TOTAL_TIME_MINS * 60;
      let percent = (currentState.time / totalSeconds) * 100;
      let pBar = document.getElementById('liveProgressBar');
      if(pBar) {
          pBar.style.width = percent + '%';
          if(currentState.time <= 300) {
              pBar.classList.add('progress-urgent');
              pBar.style.background = 'var(--danger)';
              pBar.style.boxShadow = '0 0 12px var(--danger)';
          } else {
              pBar.classList.remove('progress-urgent');
              pBar.style.background = 'var(--success)';
              pBar.style.boxShadow = '0 0 8px var(--success)';
          }
      }

      const m = Math.floor(currentState.time / 60).toString().padStart(2,'0');
      const s = (currentState.time % 60).toString().padStart(2,'0');
      const el = document.getElementById('timer');
      el.innerText = `${m}:${s}`;
      if(currentState.time < 300) el.classList.add('low');
  }, 1000);
}

