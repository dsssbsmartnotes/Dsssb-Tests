          const storageKey = source === 'mistakes' ? 'dsssb_mistakes' : 'dsssb_bookmarks';
          const raw = await getItemDB(storageKey);
          const items = raw ? JSON.parse(raw) : {};
          
          let combined = [];
          let neededTests = {};
          
          Object.values(items).forEach(item => {
              let qSec = item.section || "General";
              let qTop = item.topic || "";
              
              if (secFilter !== 'ALL' && qSec !== secFilter) return;
              if (topFilter !== 'ALL' && qTop !== topFilter) return;

              if (item.isSmartRef) {
                  if (!neededTests[item.testId]) neededTests[item.testId] = [];
                  neededTests[item.testId].push(item);
              } else {
                  combined.push(item); // Backward compatibility for old JSON saves
              }
          });
          
          for (const tId in neededTests) {
