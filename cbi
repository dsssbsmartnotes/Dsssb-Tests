function animateValue(id, start, end, duration, isFloat=false, suffix="") {
    let obj = document.getElementById(id);
    if (!obj) return;
    let startTimestamp = null;
    const step = (timestamp) => {
        if (!startTimestamp) startTimestamp = timestamp;
        const progress = Math.min((timestamp - startTimestamp) / duration, 1);
        let currentVal = progress * (end - start) + start;
        obj.innerHTML = (isFloat ? currentVal.toFixed(2) : Math.floor(currentVal)) + suffix;
        if (progress < 1) {
            window.requestAnimationFrame(step);
        } else {
            obj.innerHTML = (isFloat ? end.toFixed(2) : end) + suffix;
        }
    };
    window.requestAnimationFrame(step);
}

