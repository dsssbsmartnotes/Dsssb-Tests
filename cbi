      await setItemDB(specificStorageKey + "_final", JSON.stringify(currentState));
      await removeItemDB(specificStorageKey); 
  }
  
  renderPalette();
  renderSectionTabs();

  let totalScore = 0, correct = 0, wrong = 0, skipped = 0;
  let sectionScores = {};
  
