    questionsData.forEach((q, index) => {
        let diff = q.difficulty || q.level || "Medium";
        diff = diff.charAt(0).toUpperCase() + diff.slice(1).toLowerCase();
        if (!stats[diff]) stats[diff] = { total: 0, attempted: 0, correct: 0, wrong: 0, accuracy: 0 };
        stats[diff].total += 1;
        
        let qId = q.id || q.questionId || index;
        let ans = userAnswers ? (userAnswers[qId] || userAnswers[index]) : null;
        let isAttempted = ans && ans.selectedOption != null && ans.selectedOption !== "";
        let isCorrect = isAttempted && String(ans.selectedOption) === String(q.correctAnswer || q.answer);
        
        if (isAttempted) {
            stats[diff].attempted += 1;
            if (isCorrect) stats[diff].correct += 1;
            else stats[diff].wrong += 1;
        }
    });
    for (let diff in stats) {
        stats[diff].accuracy = stats[diff].attempted > 0 ? (stats[diff].correct / stats[diff].attempted) * 100 : 0;
    }
