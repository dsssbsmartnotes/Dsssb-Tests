      sectionScores[secName].total++;
      
      let topicName = q.topic || "General";
      if(!topicStats[topicName]) topicStats[topicName] = {c:0, w:0, s:0, time:0};
      
      let timeForThisQ = currentState.timePerQ[i] || 0;
      if(timeForThisQ > slowest) slowest = timeForThisQ;
      if(timeForThisQ < fastest && timeForThisQ > 0) fastest = timeForThisQ;

      sectionScores[secName].time += timeForThisQ;
      topicStats[topicName].time += timeForThisQ;

      const correctIdx = parseInt(q.ans) - 1;
      const myAns = currentState.answers[i];
