function copyCurrentQuestion() {
    const q = QUESTIONS[currentState.idx];
    if (!q) return;
    
    const currentLangBtnText = document.getElementById('langBtn').innerText.trim().toUpperCase();
    const isHindi = (q.forceLanguage) ? (q.forceLanguage === 'hi') : (currentLangBtnText === "HI");
    
    const qTextRaw = isHindi ? (q.q_hi || q.q_en) : (q.q_en || q.q_hi);
    const optsArr = isHindi ? (q.op_hi || q.op_en) : (q.op_en || q.op_hi);
    
    // HTML elements ko hata kar clear plain text banane ke liye
