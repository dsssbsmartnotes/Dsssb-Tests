}

function calculateAccuracyStats(totalQuestions, totalAttempted, correctAnswers, incorrectAnswers) {
    let tq = totalQuestions || 1;
    let skipped = (totalQuestions || 0) - (totalAttempted || 0);
    return {
        overallAccuracy: totalAttempted > 0 ? (correctAnswers / totalAttempted) * 100 : 0,
        attemptRate: totalQuestions > 0 ? (totalAttempted / tq) * 100 : 0,
        wrongRate: totalQuestions > 0 ? (incorrectAnswers / tq) * 100 : 0,
        skipRate: totalQuestions > 0 ? (skipped / tq) * 100 : 0,
        correctPercentage: totalQuestions > 0 ? (correctAnswers / tq) * 100 : 0
    };
}

function calculateSpeedStats(questionsData, userAnswers) {
    let stats = {
        averageTime: null,
        fastestCorrect: null,
        slowestCorrect: null,
        fastestWrong: null,
        slowestWrong: null
    };
    if (!questionsData || !Array.isArray(questionsData) || !userAnswers) return stats;
    let totalTime = 0, count = 0;
    let correctTimes = [], wrongTimes = [];
    questionsData.forEach((q, index) => {
        let qId = q.id || q.questionId || index;
        let ans = userAnswers[qId] || userAnswers[index];
        
        if (ans && typeof ans.timeSpent !== 'undefined' && ans.timeSpent !== null) {
            let time = parseFloat(ans.timeSpent);
            if (!isNaN(time)) {
                totalTime += time;
                count++;
                let isAttempted = ans.selectedOption != null && ans.selectedOption !== "";
                let isCorrect = isAttempted && String(ans.selectedOption) === String(q.correctAnswer || q.answer);
                
                if (isAttempted) {
                    if (isCorrect) correctTimes.push(time);
                    else wrongTimes.push(time);
                }
            }
        }
    });
    
    if (count > 0) stats.averageTime = totalTime / count;
    if (correctTimes.length > 0) {
        stats.fastestCorrect = Math.min(...correctTimes);
        stats.slowestCorrect = Math.max(...correctTimes);
    }
    if (wrongTimes.length > 0) {
        stats.fastestWrong = Math.min(...wrongTimes);
        stats.slowestWrong = Math.max(...wrongTimes);
    }
    return stats;
}
function calculateWeakTopics(topicPerformanceObj) {
    let validTopics = [];
    for (let topic in topicPerformanceObj) {
        let stats = topicPerformanceObj[topic];
        if (stats.total >= 2) {
            let priorityScore = "Low";
            if (stats.accuracy < 40) priorityScore = "High";
            else if (stats.accuracy < 70) priorityScore = "Medium";

            validTopics.push({
                topic: topic,
                total: stats.total,
                attempted: stats.attempted,
                correct: stats.correct,
                wrong: stats.wrong,
                accuracy: stats.accuracy,
                priorityScore: priorityScore
            });
        }
    }

    validTopics.sort((a, b) => {
        if (a.accuracy !== b.accuracy) return a.accuracy - b.accuracy; 
        if (a.wrong !== b.wrong) return b.wrong - a.wrong; 
        return b.total - a.total; 
    });

    let weakTopicsList = validTopics.slice(0, 5);
    let criticalImprovementAreas = validTopics.slice(0, 3);

    return {
        weakTopicsList: weakTopicsList,
        criticalImprovementAreas: criticalImprovementAreas,
        recommendedFocus: criticalImprovementAreas.length > 0 ? "Focus heavily on: " + criticalImprovementAreas.map(t => t.topic).join(", ") : "All Clear"
    };
}

function calculateStrongTopics(topicPerformanceObj) {
    let validTopics = [];
    for (let topic in topicPerformanceObj) {
        let stats = topicPerformanceObj[topic];
        let masteryLevel = "Needs Practice";
        if (stats.accuracy >= 80) masteryLevel = "Excellent";
        else if (stats.accuracy >= 60) masteryLevel = "Good";
        else if (stats.accuracy >= 40) masteryLevel = "Average";

        validTopics.push({
            topic: topic,
            accuracy: stats.accuracy,
            correct: stats.correct,
            masteryLevel: masteryLevel
        });
    }

    validTopics.sort((a, b) => {
        if (b.accuracy !== a.accuracy) return b.accuracy - a.accuracy;
        return b.correct - a.correct;
    });

    let strongTopicsList = validTopics.slice(0, 5);
    return {
        strongTopicsList: strongTopicsList,
        masteredAreas: validTopics.filter(t => t.masteryLevel === "Excellent").slice(0, 3),
        retentionStatus: strongTopicsList.length > 0 ? "Strong Retention" : "Requires Review"
    };
}

function generateOfflineRecommendations(weakTopics, timeStats, accuracyStats) {
    let acc = accuracyStats ? accuracyStats.overallAccuracy : 0;
    let attempt = accuracyStats ? accuracyStats.attemptRate : 0;
    
    let studyStrategy = "";
    if (acc < 40) studyStrategy = "Heavy Revision";
    else if (acc < 60) studyStrategy = "Practice PYQs";
    else if (acc < 80) studyStrategy = "Revision Test";
    else studyStrategy = "Maintain Strength";

    let timeTips = [];
    if (timeStats && timeStats.averageTime > 60) timeTips.push("Average time per question is high. Focus on speed.");
    if (timeStats && timeStats.slowestWrong) timeTips.push("Avoid getting stuck on difficult questions. Skip and review later.");
    if (timeTips.length === 0) timeTips.push("Pacing is adequate. Keep practicing under timed conditions.");

    let actionItems = [];
    if (weakTopics && weakTopics.criticalImprovementAreas) {
        weakTopics.criticalImprovementAreas.forEach(t => actionItems.push("Review basics and formulas of " + t.topic));
    }
    if (attempt < 70) actionItems.push("Attempt more questions to maximize scoring potential.");

    return {
        actionItems: actionItems,
        studyStrategy: studyStrategy,
        revisionPriority: weakTopics && weakTopics.weakTopicsList ? weakTopics.weakTopicsList.map(t => t.topic) : [],
        examReadiness: Math.round(acc),
        timeManagementTips: timeTips
    };
}

function generateOfflineAISummary(accuracy, speed, weakTopics, strongTopics) {
    let acc = accuracy ? accuracy.overallAccuracy : 0;
    
    let overallRating = "Needs Improvement";
    if (acc >= 85) overallRating = "Excellent";
    else if (acc >= 70) overallRating = "Very Good";
    else if (acc >= 55) overallRating = "Good";
    else if (acc >= 40) overallRating = "Average";

    let readinessScore = Math.round(acc);
    
    let confidenceLevel = "Low";
    if (acc >= 75) confidenceLevel = "High";
    else if (acc >= 50) confidenceLevel = "Medium";

    let estImprovement = (100 - acc) * 0.2; 
    let estimatedScoreImprovement = "+" + Math.max(1, Math.round(estImprovement)) + "% expected improvement with targeted practice.";

    let insights = [];
    
    if (accuracy && accuracy.skipRate > 30) {
        insights.push("High skip rate detected. Work on question selection confidence.");
    } else if (accuracy && accuracy.skipRate < 5 && accuracy.wrongRate > 40) {
        insights.push("You are attempting too many questions blindly. Negative marking is hurting your score.");
    } else {
        insights.push("Attempt rate and accuracy balance is moderate.");
    }

    if (speed && speed.fastestWrong && speed.fastestWrong < 10) {
        insights.push("Silly mistakes are likely happening on easy questions due to rushing.");
    }
    
    if (weakTopics && weakTopics.criticalImprovementAreas.length > 0) {
        let weakNames = weakTopics.criticalImprovementAreas.map(t => t.topic).join(", ");
        insights.push("Critical weakness found in: " + weakNames + ".");
    }
    
    if (strongTopics && strongTopics.strongTopicsList.length > 0) {
        insights.push("Strong grasp on: " + strongTopics.strongTopicsList[0].topic + ". Keep leveraging this strength!");
    }
    
    if (acc < 50) {
        insights.push("Foundational concepts need immediate attention before attempting full mock tests.");
    } else {
        insights.push("You are ready for advanced level practice and section-wise timed tests.");
    }

    let summaryText = `Your overall exam readiness is ${overallRating.toLowerCase()}. `;
    if (strongTopics && strongTopics.strongTopicsList.length > 0) {
        summaryText += `Your performance in ${strongTopics.strongTopicsList[0].topic} is excellent, `;
    }
    if (weakTopics && weakTopics.criticalImprovementAreas.length > 0) {
        summaryText += `but ${weakTopics.criticalImprovementAreas[0].topic} requires immediate attention. `;
    }
    if (accuracy && accuracy.wrongRate > 30) {
        summaryText += `Additionally, a high number of incorrect attempts is reducing your overall score.`;
    }

   let finalPayload = {
        summaryText: summaryText.trim(),
        overallRating: overallRating,
        readinessScore: readinessScore,
        confidenceLevel: confidenceLevel,
        estimatedScoreImprovement: estimatedScoreImprovement,
        insights: insights.slice(0, 5),
        weakSubjects: (weakTopics && weakTopics.criticalImprovementAreas) ? weakTopics.criticalImprovementAreas.map(t => t.topic) : [],
        strongSubjects: (strongTopics && strongTopics.strongTopicsList) ? strongTopics.strongTopicsList.map(t => t.topic) : [],
        timestamp: Date.now()
    };
    
    // MASTER ECOSYSTEM INTEGRATION: Save CBT AI output to shared local schema
    try {
        if (typeof getItemDB === 'function' && typeof setItemDB === 'function') {
            getItemDB('dsssb_analysis_data').then(resStr => {
                let existingData = resStr ? JSON.parse(resStr) : {};
                existingData.latestAIReport = finalPayload;
                setItemDB('dsssb_analysis_data', JSON.stringify(existingData));
            }).catch(e => console.warn("AI Sync failed", e));
        }
    } catch(e) {}

    return finalPayload;
}

if ('serviceWorker' in navigator && window.location.protocol.startsWith('http')) {
  window.addEventListener('load', () => { navigator.serviceWorker.register('sw.js').catch(err => console.error('Service Worker Error:', err)); });
}
